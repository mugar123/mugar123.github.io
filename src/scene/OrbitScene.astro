---
import type { SceneSatellite } from '@/lib/satellites';
import Fallback from './Fallback.astro';
interface Props { satellites: SceneSatellite[] }
const { satellites } = Astro.props;
---
<div id="orbit-scene" class="orbit-scene" data-satellites={JSON.stringify(satellites)} data-state="fallback">
  <Fallback satellites={satellites} />
</div>

<script>
  import { bootOrbitScene } from '@/scene/island';

  const root = document.getElementById('orbit-scene');
  if (root) bootOrbitScene(root);
</script>

<style is:global>
  .orbit-scene { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; container-type: inline-size; }
  .orbit-scene [data-fallback] { transition: opacity 500ms var(--ease); }
  .orbit-scene[data-ready='true'] [data-fallback] { opacity: 0; }
  .orbit-scene [data-fallback][hidden] { display: none !important; }

  .orbit-stage {
    position: absolute; inset: 0; opacity: 0; transition: opacity 500ms var(--ease);
    user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
  }
  .orbit-scene[data-ready='true'] .orbit-stage { opacity: 1; }
  .orbit-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .orbit-overlay { position: absolute; inset: 0; pointer-events: none; }

  /* Satellite labels: the fallback's chip and leader line, re-placed every frame. */
  .orbit-label { position: absolute; left: 0; top: 0; will-change: transform; transition: opacity var(--dur) var(--ease), visibility var(--dur); }
  .orbit-label__text {
    position: absolute; top: 0; left: 0; display: block; width: max-content; max-width: var(--label-max, 40%);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    transform: translate(calc(var(--sat-r) + 14px), -50%);
    color: var(--ink-2); background: var(--paper); padding: 0 0.3em;
    transition: transform var(--dur) var(--ease);
  }
  .orbit-label::before {
    content: ''; position: absolute; top: 0; left: calc(var(--sat-r) + 3px); width: 9px; border-top: 1px solid var(--ink-2);
    transition: left var(--dur) var(--ease);
  }
  .orbit-label.is-left .orbit-label__text { transform: translate(calc(-100% - var(--sat-r) - 14px), -50%); }
  .orbit-label.is-left::before { left: calc(-1 * var(--sat-r) - 12px); }
  /* Behind the planet: hidden, not faded (a 30 % label read at only 1.46:1). It fades out, then leaves the accessibility tree. */
  .orbit-label.is-occluded { opacity: 0; visibility: hidden; }

  /* Narrow scenes (phones): 12 px name labels would cover the planet and truncate, and the projects are
     listed right below the hero, so the names and their leader lines go. */
  @container (max-width: 479px) {
    .orbit-label { display: none; }
  }
</style>
