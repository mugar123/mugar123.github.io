---
/**
 * LaTeX converter: a dark stage where the sheet of notes is the one lit object. scripts/scroll.ts
 * drives it while the section is pinned: the compiled page is uncovered from the top (clip-path on
 * [data-tex]) under a beam that also reaches the active step in the legend beside it. Without the
 * script, or with reduced motion, the page is shown compiled and nothing moves.
 */
import '@fontsource/caveat/latin-500.css';
---
<section class="lc section--dark" aria-labelledby="notes-title" data-scan>
  <div class="lc__stage container--wide">
    <header class="lc__head">
      <p class="lc-brand"><img src="/latex/openclaw.svg" alt="OpenClaw" width="56" height="56" />LaTeX converter</p>
      <h2 class="headline" id="notes-title">From my notebook to LaTeX. Automatically.</h2>
      <p class="lede">Photos of handwritten lecture pages become structured LaTeX documents. <strong>Claude Opus 5.5 splits the transcription</strong> across low-cost open-source models, and the figures come back as LaTeX graphics.</p>
      <p class="lc__note">One reusable template keeps the format, notation and structure the same in every set of notes, which go to my classmates. The pipeline is private for now.</p>
    </header>

    <div class="lc-sheet" data-sheet>
      <div class="lc-page hand" aria-hidden="true">
        <p class="hand__title">Change of variables <span>(thm.)</span></p>
        <p>φ : U → V  C¹ diffeo,  U, V ⊂ ℝⁿ open</p>
        <p><span class="hand__eq">∫<sub>V</sub> f(y) dy = ∫<sub>U</sub> f(φ(x)) |det Dφ(x)| dx</span></p>
        <p>e.g. polar: x = r cos θ, y = r sin θ</p>
        <p><span class="hand__arrow">→</span> |det Dφ| = r,  so ∬<sub>disc</sub> f = ∫∫ f · r dr dθ</p>
        <svg class="hand__fig" viewBox="0 0 300 120">
          <path d="M14 104 L118 102.5" /><path d="M112 98.5 L119 102.6 L112 106.5" />
          <path d="M18 108 L19.5 10" /><path d="M15 17 L19.6 9.5 L24 16.5" />
          <path d="M19 89 C 40 88, 62 90.5, 84 88.6 L 85.5 36 C 62 37.5, 40 35, 19.5 36.5" />
          <text x="44" y="70">U</text>
          <text x="80" y="119">R</text><text x="0" y="40">2π</text>
          <text x="114" y="118">r</text><text x="26" y="14">θ</text>
          <path class="red" d="M122 58 C 142 46, 164 46, 184 56" /><path class="red" d="M176 50.5 L185 56.5 L176 61" />
          <text x="146" y="40">φ</text>
          <path d="M246 22 C 268 21, 285 40, 284 62 C 283 86, 264 101, 242 100 C 220 99, 203 82, 204 60 C 205 38, 224 23, 246 22 Z" />
          <path d="M244 61 L284 61" stroke-dasharray="3 4" />
          <text x="222" y="54">V</text>
        </svg>
      </div>

      <div class="lc-page lc-tex" data-tex>
        <p class="lc-tex__run" aria-hidden="true"><span>Multiple integrals</span></p>
        <p><b>Theorem 1</b> (Change of variables)<b>.</b> <i>Let U, V ⊂ ℝ<sup>n</sup> be open and φ : U → V a C<sup>1</sup> diffeomorphism. Then, for every integrable f : V → ℝ,</i></p>
        <math display="block">
          <msub><mo>∫</mo><mi>V</mi></msub><mi>f</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mspace width="0.17em" /><mi>d</mi><mi>y</mi>
          <mo>=</mo>
          <msub><mo>∫</mo><mi>U</mi></msub><mi>f</mi><mo stretchy="false">(</mo><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mspace width="0.17em" />
          <mo form="prefix" stretchy="false">|</mo><mi>det</mi><mspace width="0.17em" /><mi>D</mi><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo form="postfix" stretchy="false">|</mo><mspace width="0.17em" /><mi>d</mi><mi>x</mi><mo>.</mo>
        </math>
        <p><b>Example</b> (Polar coordinates)<b>.</b> With <math><mi>x</mi><mo>=</mo><mi>r</mi><mspace width="0.17em" /><mi>cos</mi><mspace width="0.17em" /><mi>θ</mi></math> and <math><mi>y</mi><mo>=</mo><mi>r</mi><mspace width="0.17em" /><mi>sin</mi><mspace width="0.17em" /><mi>θ</mi></math>, one has <span class="lc-nb"><math><mo form="prefix" stretchy="false">|</mo><mi>det</mi><mspace width="0.17em" /><mi>D</mi><mi>φ</mi><mo form="postfix" stretchy="false">|</mo><mo>=</mo><mi>r</mi></math>, so</span></p>
        <math display="block">
          <msub><mo>∬</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>&lt;</mo><msup><mi>R</mi><mn>2</mn></msup></mrow></msub><mi>f</mi><mspace width="0.17em" /><mi>d</mi><mi>x</mi><mspace width="0.17em" /><mi>d</mi><mi>y</mi>
          <mo>=</mo>
          <msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><mi>π</mi></mrow></msubsup><msubsup><mo>∫</mo><mn>0</mn><mi>R</mi></msubsup><mi>f</mi><mspace width="0.17em" /><mi>r</mi><mspace width="0.17em" /><mi>d</mi><mi>r</mi><mspace width="0.17em" /><mi>d</mi><mi>θ</mi><mo>.</mo>
        </math>
        <figure>
          <svg class="tikz" viewBox="0 0 300 120" role="img" aria-label="The rectangle U in the (r, θ) plane mapped by φ onto the disc V">
            <path class="rg" d="M20 88 H84 V36 H20 Z" />
            <path class="ax" d="M12 104 H118 M20 110 V8" />
            <path class="ax" d="M114 101 L119 104 L114 107 M17 13 L20 8 L23 13" />
            <path class="ax" d="M84 102 V106 M18 36 H22" />
            <text class="it" x="45" y="67">U</text>
            <text class="it" x="80" y="118">R</text><text x="0" y="40">2π</text>
            <text class="it" x="112" y="118">r</text><text class="it" x="26" y="13">θ</text>
            <path class="arr" d="M126 58 Q 154 44 182 58" /><path class="arr" d="M176 53.5 L183 58.5 L176 61.5" />
            <text class="it" x="150" y="42">φ</text>
            <circle class="rg" cx="244" cy="61" r="40" />
            <path class="ray" d="M244 61 H284" />
            <circle cx="244" cy="61" r="1.4" fill="#111" />
            <text class="it" x="222" y="52">V</text>
          </svg>
          <figcaption><b>Figure 1.</b> Polar coordinates, <math><mi>φ</mi><mo>:</mo><mi>U</mi><mo>→</mo><mi>V</mi></math>.</figcaption>
        </figure>
        <p class="lc-tex__folio" aria-hidden="true">1</p>
      </div>

      <div class="lc-beam" data-beam aria-hidden="true"></div>
      <p class="lc-file" aria-hidden="true"><span class="lc-file__in">IMG_2041.jpg</span><span class="lc-file__out">notes.tex · compiled</span></p>
    </div>

    <ol class="lc-legend" data-steps>
      <li><span><b>Photograph</b> the page</span></li>
      <li><span><b>Models read</b> the handwriting, open and closed</span></li>
      <li><span><b>LaTeX comes out</b>, and it compiles</span></li>
    </ol>
  </div>
</section>

<style>
  /* LaTeX converter, dark stage: the page is the only lit thing in the room. */
  .lc { position: relative; height: 300vh; overflow: clip; }
  .lc__stage {
    position: sticky; top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 16rem;
    grid-template-areas: "head sheet legend";
    align-items: center;
    column-gap: clamp(2rem, 3.6vw, 3.25rem);
    padding-block: 5rem 3rem;
  }

  /* The story. */
  .lc__head { grid-area: head; display: grid; gap: 1.25rem; align-content: center; }
  .lc-brand {
    display: flex; align-items: center; gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.005em;
  }
  .lc-brand img { width: 3.5rem; height: 3.5rem; flex: none; }
  .lc__head .headline { font-size: clamp(2.25rem, 3.2vw, 2.875rem); line-height: 1.06; letter-spacing: -0.02em; }
  .lc__head .lede { font-size: 1.1875rem; line-height: 1.42; max-width: 28rem; }
  .lc__note {
    margin-top: 0.75rem; padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 28rem;
    font-size: 0.875rem; line-height: 1.43; letter-spacing: 0.01em; color: var(--on-dark-2);
    text-wrap: pretty;
  }

  /* The page. One rectangle, two layers: the notebook below, the PDF above. */
  .lc-sheet {
    --h: min(37rem, 100svh - 12rem);
    grid-area: sheet;
    position: relative;
    height: var(--h);
    width: calc(var(--h) / 1.414);
    container-type: size;
  }
  .lc-page {
    position: absolute; inset: 0;
    border-radius: 0.25rem;
    overflow: hidden;
    text-align: left;
  }

  /* As written: ruled notebook paper, blue ink, a red margin and three punched holes. */
  .hand {
    --rule: 7.4cqh;
    font-family: 'Caveat', 'Bradley Hand', 'Segoe Print', cursive;
    font-weight: 500;
    font-size: min(5.6cqi, 4cqh);
    line-height: var(--rule);
    letter-spacing: 0;
    color: #1d3c8f;
    background:
      radial-gradient(circle at 1.5rem 18%, #000 0.4375rem, rgba(0, 0, 0, 0.14) calc(0.4375rem + 0.5px), transparent calc(0.4375rem + 1.5px)),
      radial-gradient(circle at 1.5rem 50%, #000 0.4375rem, rgba(0, 0, 0, 0.14) calc(0.4375rem + 0.5px), transparent calc(0.4375rem + 1.5px)),
      radial-gradient(circle at 1.5rem 82%, #000 0.4375rem, rgba(0, 0, 0, 0.14) calc(0.4375rem + 0.5px), transparent calc(0.4375rem + 1.5px)),
      linear-gradient(90deg, transparent 3.25rem, rgba(209, 52, 43, 0.4) 3.25rem calc(3.25rem + 1px), transparent calc(3.25rem + 1px)),
      repeating-linear-gradient(transparent 0 calc(var(--rule) - 1px), #cfdaeb calc(var(--rule) - 1px) var(--rule)),
      #fbfaf4;
    background-position: 0 0, 0 0, 0 0, 0 0, 0 calc(var(--rule) * 1.5), 0 0;
    padding: calc(var(--rule) * 1.5) 7cqi 0 calc(3.25rem + 4cqi);
  }
  .hand p { white-space: nowrap; }
  .hand p:nth-child(even) { transform: translateX(0.35rem) rotate(0.4deg); }
  .hand__title { font-size: 1.2em; text-decoration: underline 0.08em; text-underline-offset: 0.18em; }
  .hand__title span { font-size: 0.72em; opacity: 0.7; }
  .hand__eq {
    display: inline-block; margin: 0.15em 0 0.1em -0.35em; padding: 0 0.35em;
    border: 0.09em solid currentColor;
    border-radius: 1.2em 0.3em 1em 0.25em / 0.3em 1em 0.3em 1.1em;
    line-height: calc(var(--rule) * 1.25);
  }
  .hand sub { font-size: 0.6em; line-height: 0; }
  .hand__arrow { color: #c7372d; }
  .hand__fig { width: 86%; height: auto; margin-top: calc(var(--rule) * 0.4); overflow: visible; }
  .hand__fig path, .hand__fig line { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hand__fig text { fill: currentColor; font-family: 'Caveat', 'Bradley Hand', cursive; font-size: 17px; }
  .hand__fig .red { stroke: #c7372d; }

  /* As compiled: an A4 page set in a book face, with a TikZ figure and a folio. */
  .lc-tex {
    background: #fff;
    color: #111;
    font-family: var(--math);
    font-size: clamp(0.75rem, min(3.45cqi, 2.45cqh), 1rem);
    line-height: 1.45;
    letter-spacing: 0;
    padding: 11cqh 10cqi 0;
    display: flex; flex-direction: column; gap: 0.85em;
    clip-path: inset(0 0 100% 0);
  }
  .lc-tex__run {
    position: absolute; top: 5cqh; left: 10cqi; right: 10cqi;
    padding-bottom: 0.45em;
    border-bottom: 0.5px solid #111;
    font: italic 0.78em/1 var(--math); color: #333;
  }
  .lc-tex b { font-weight: 700; }
  .lc-tex > p { text-wrap: pretty; }
  .lc-nb { white-space: nowrap; }
  .lc-tex i { font-style: italic; }
  .lc-tex math { font-size: 1.06em; margin: 0.1em 0; overflow-x: auto; overflow-y: hidden; }
  .lc-tex figure { margin: 0.4em 0 0; display: grid; gap: 0.6em; justify-items: center; }
  .lc-tex figure svg { width: 92%; height: auto; overflow: visible; }
  .lc-tex figcaption { font-size: 0.86em; text-align: center; }
  .lc-tex__folio { position: absolute; bottom: 5cqh; left: 0; right: 0; text-align: center; font-size: 0.86em; }
  .tikz .ax { stroke: #111; stroke-width: 0.8; fill: none; }
  .tikz .rg { fill: #ececec; stroke: #111; stroke-width: 0.9; }
  .tikz .ray { stroke: #fff; stroke-width: 1.6; }
  .tikz .arr { stroke: #111; stroke-width: 0.8; fill: none; }
  .tikz text { font-family: var(--math); font-size: 13px; fill: #111; }
  .tikz .it { font-style: italic; }

  /* The beam: one blue hairline that runs past the page and points at the legend. */
  .lc-beam {
    position: absolute; top: 0; left: -1.25rem; right: calc(-1 * clamp(2rem, 3.6vw, 3.25rem));
    height: 1px;
    background: var(--link-on-dark);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
    will-change: transform;
  }

  /* File name under the page, swapped when the page is done. */
  .lc-file {
    position: absolute; top: calc(100% + 1rem); left: 0;
    display: grid;
    font: 400 0.75rem/1.2 var(--mono); letter-spacing: 0; color: var(--on-dark-2);
  }
  .lc-file > span { grid-area: 1 / 1; transition: opacity 300ms ease; }
  .lc-file__out { opacity: 0; }
  .is-done .lc-file__in { opacity: 0; }
  .is-done .lc-file__out { opacity: 1; }

  /* The legend: each step sits at the height where the beam is while it happens. */
  .lc-legend {
    grid-area: legend;
    position: relative;
    align-self: stretch;
    list-style: none; margin: 0; padding: 0;
    counter-reset: step;
  }
  .lc-legend li {
    counter-increment: step;
    position: absolute; left: 0; right: 0;
    transform: translateY(-50%);
    display: grid; grid-template-columns: 1.5rem 1.25rem 1fr; align-items: baseline;
    font-size: 0.9375rem; line-height: 1.4; letter-spacing: 0.005em;
    color: var(--on-dark-2);
    transition: color 300ms ease;
  }
  .lc-legend li:nth-child(1) { top: calc(50% - var(--lh) / 2); }
  .lc-legend li:nth-child(2) { top: 50%; }
  .lc-legend li:nth-child(3) { top: calc(50% + var(--lh) / 2); }
  .lc-legend { --lh: min(37rem, 100svh - 12rem); }
  .lc-legend li::before {
    content: '';
    grid-column: 1; grid-row: 1; align-self: center;
    width: 1rem; height: 1px;
    background: rgba(255, 255, 255, 0.24);
    transition: background-color 300ms ease;
  }
  .lc-legend li::after {
    content: counter(step);
    grid-column: 2; grid-row: 1;
    font: 400 0.8125rem/1 var(--mono);
  }
  .lc-legend li > span { grid-column: 3; grid-row: 1; text-wrap: balance; }
  .lc-legend b { font-weight: 600; }
  .lc-legend li.is-on { color: var(--on-dark); }
  .lc-legend li.is-on::before { background: var(--link-on-dark); }

  /* Narrower desktops: the legend joins the story, as an ordinary list. */
  @media (max-width: 1080px) {
    .lc__stage { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "head sheet" "legend sheet"; align-content: center; row-gap: 2rem; }
    .lc__head { align-self: end; }
    .lc-beam { right: -1.25rem; }
    .lc-legend { align-self: start; display: grid; }
    .lc-legend li { position: static; transform: none; padding-block: 0.625rem; border-top: 1px solid rgba(255, 255, 255, 0.12); grid-template-columns: 1.5rem 1fr; }
    .lc-legend li:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
    .lc-legend li::before { display: none; }
    .lc-legend li::after { grid-column: 1; }
    .lc-legend li > span { grid-column: 2; }
    .lc-legend li.is-on::after { color: var(--link-on-dark); }
  }

  @media (max-width: 620px) {
    .lc__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "sheet" "legend";
      align-content: center; row-gap: 1.25rem;
      padding-block: 4rem 1.25rem;
    }
    .lc__head { gap: 0.75rem; }
    .lc-brand { gap: 0.75rem; margin-bottom: 0.25rem; font-size: 1.3125rem; }
    .lc-brand img { width: 2.5rem; height: 2.5rem; }
    .lc__head .headline { font-size: clamp(1.875rem, 8.7vw, 2.125rem); }
    .lc__head .lede, .lc__note { display: none; }
    .lc-sheet { --h: clamp(13rem, 100svh - 27.5rem, 24rem); width: 100%; }
    .lc-beam { left: -0.5rem; right: -0.5rem; }
    .lc-file { display: none; }
    .hand { font-size: min(5cqi, 4.4cqh); padding-left: calc(3.25rem + 2cqi); }
    .lc-tex { font-size: clamp(0.6875rem, min(3.5cqi, 3.15cqh), 0.875rem); padding: 6cqh 7cqi 0; gap: 0.7em; }
    .lc-tex__run, .lc-tex__folio { display: none; }
    .lc-tex figure svg { width: 80%; }
    .lc-legend li { font-size: 0.875rem; padding-block: 0.5rem; }
  }

  @media (max-height: 760px) and (min-width: 621px) {
    .lc__note { display: none; }
  }

  /* Without the scroll script, or when motion is reduced: the finished page, nothing pinned. */
  :global(html:not(.js)) .lc, :global(html.reduce) .lc { height: auto; }
  :global(html:not(.js)) .lc__stage, :global(html.reduce) .lc__stage { position: static; height: auto; padding-block: clamp(5rem, 11vw, 10rem); }
  :global(html:not(.js)) .lc-tex, :global(html.reduce) .lc-tex { clip-path: none; }
  :global(html:not(.js)) .lc-beam, :global(html.reduce) .lc-beam { display: none; }
  :global(html:not(.js)) .lc-legend li, :global(html.reduce) .lc-legend li { color: var(--on-dark); }
  :global(html:not(.js)) .lc__head .lede, :global(html.reduce) .lc__head .lede,
  :global(html:not(.js)) .lc__note, :global(html.reduce) .lc__note { display: block; }
  :global(html:not(.js)) .lc-file__in { opacity: 0; }
  :global(html:not(.js)) .lc-file__out { opacity: 1; }
</style>
