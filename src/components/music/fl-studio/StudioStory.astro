---
/**
 * The last chapter on the music page, after the instruments: making beats in FL Studio. The words are
 * told in the instruments' language (a sentence for a title, a story that lights up as the reader
 * scrolls, on black). Under them stands FL Studio's piano roll as it really looks, redrawn in HTML, CSS
 * and SVG from the screenshots in Image-Line's manual (pianoroll.htm), pixel for pixel: the slate window
 * and its tool bar, the note-colour swatch, the scroll bars and the bar ruler, the keyboard, the
 * blue-grey grid, pale green notes with their names, and the velocity editor underneath.
 *
 * Every measure below is a pixel of that screenshot (`--u`), so the window keeps FL's proportions at any
 * size, and the hairlines stay one pixel wide as they do in FL when its interface is scaled.
 *
 * As the reader scrolls, the screen holds, the window arrives, and two bars of a trap melody are drawn
 * in left to right, the way notes are drawn with the pencil; each key goes down while its note is being
 * drawn. Last, every note's velocity rises in the editor. The chapter is silent and there is nothing to
 * press; it moves with the scroll only, and backwards with it.
 *
 * Where the instruments come before it, the chapter does not scroll in: FL's playhead crosses the
 * instruments' screen and turns it into this one, and the guitars become the first notes (handoff.ts).
 *
 * Behaviour lives in write-beat.ts. Without the script, or with reduced motion: the finished roll.
 */
import '../v4/text-fill.css';
import '../lineup/lineup.css';
import { flIcons } from './fl-icons';
import PlaylistBackdrop from './PlaylistBackdrop.astro';

const title = 'I learned FL Studio on my own.';
const body = 'I plug in my MIDI controller and try out different genres, and I usually end up making trap. I don’t have much time for it anymore, but every so often I still make a beat.';

const STEPS = 32;
const ROWS = 16;
const TOP = 75; // D#5 on the top row, C4 on the bottom one.
const NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const isBlack = (midi: number) => [1, 3, 6, 8, 10].includes(midi % 12);
const nameOf = (midi: number) => `${NAMES[midi % 12]}${Math.floor(midi / 12) - 1}`;
const rowOf = (midi: number) => TOP - midi;
const pitches = Array.from({ length: ROWS }, (_, row) => TOP - row);
const pct = (n: number, of: number) => `${(n / of * 100).toFixed(4)}%`;

// A white key reaches halfway into the row of each black key beside it, as on the real keyboard.
const whiteKeys = Array.from({ length: ROWS + 4 }, (_, i) => TOP + 2 - i)
  .filter(midi => !isBlack(midi))
  .map(midi => {
    const top = Math.max(0, rowOf(midi) - (isBlack(midi + 1) ? .5 : 0));
    const bottom = Math.min(ROWS, rowOf(midi) + 1 + (isBlack(midi - 1) ? .5 : 0));
    return { midi, top, height: bottom - top, label: midi % 12 === 0 ? nameOf(midi) : '' };
  })
  .filter(key => key.height > 0);
// The grid's line under each C is a shade darker than the others.
const octaves = pitches.filter(midi => midi % 12 === 0).map(rowOf).filter(row => row < ROWS - 1)
  .map(row => `linear-gradient(#0d0d0d,#0d0d0d) 0 calc(var(--row) * ${row + 1} - 1px) / 100% 1px no-repeat`);

// [step, length, pitch, velocity]: a melody in C minor over a held line underneath it.
const notes = ([
  [0, 3, 72, 100], [3, 3, 67, 78], [6, 2, 75, 92], [8, 4, 74, 96], [12, 2, 67, 70], [14, 2, 68, 84],
  [16, 3, 72, 100], [19, 3, 67, 76], [22, 2, 75, 94], [24, 2, 74, 88], [26, 2, 72, 80], [28, 4, 68, 90],
  [0, 8, 63, 58], [8, 8, 62, 52], [16, 8, 60, 60], [24, 8, 62, 52],
] as const).map(([step, length, midi, velocity]) => ({ step, length, midi, velocity }));

// The tool bar, left to right. `lead` opens the wider gap FL leaves before a group.
type Tool = { d: string; tone?: 'dim' | 'mint' | 'lime' | 'yellow'; lead?: 'group' | 'play' };
const tools: Tool[] = [
  { d: 'M33.8 25.4 47.9 39.5 33.8 53.6Z', tone: 'dim' },
  { d: flIcons.wrench },
  { d: flIcons.magnet },
  { d: flIcons.note, tone: 'mint' },
  { d: flIcons.stamp },
  { d: 'M25.1 33.4 40.8 19.3V28.3H44.3A11.2 11.2 0 0 1 55.5 39.5V45.6C55.5 53.8 46.3 56.8 32 56.6 41.2 54.8 48.7 51.7 48.7 45.6V42.3A4.7 4.7 0 0 0 44 37.6H40.8V47.6Z', tone: 'lime' },
  { d: flIcons.pencil, tone: 'yellow', lead: 'group' },
  { d: flIcons.brush },
  { d: flIcons.brushPlus },
  { d: flIcons.erase },
  { d: flIcons.mute },
  { d: flIcons.interpolate },
  { d: flIcons.slice },
  { d: flIcons.select },
  { d: flIcons.zoom },
  { d: flIcons.playback },
  { d: flIcons.play, lead: 'play' },
];
const CHEVRON = 'M15.6 8.4 9.9 14.5 15.6 20.6';
---
<section id="fl-studio" class="studio" aria-labelledby="fl-title" data-studio>
  <div class="studio__stage">
    <!-- A window and its content: the playhead's wipe moves them against each other (handoff.ts). -->
    <div class="studio__wipe" data-studio-wipe>
    <div class="studio__world" data-studio-world>
    <PlaylistBackdrop continued={Astro.slots.has('default')} />
    <header class="lu__words studio__words">
      <h2 class="lu__title" id="fl-title" data-fill-text>{title.split(' ').map(word => <><span data-w>{word}</span>{' '}</>)}</h2>
      <p class="lu__body" data-fill-text>{body.split(' ').map(word => <><span data-w>{word}</span>{' '}</>)}</p>
    </header>
    <div class="studio__desktop">
      <div class="roll">
        <div class="fl" aria-hidden="true" style={`--steps:${STEPS};--rows:${ROWS};--octaves:${octaves.join(',') || 'none'}`} data-fl>
          <div class="fl__bar">
            <div class="fl__tools">
              {tools.map(({ d, tone, lead }) => (
                <svg class:list={['fl__tool', tone && `is-${tone}`, lead && `leads-${lead}`]} viewBox="6.7 -4.4 66.6 81.6"><path fill-rule="evenodd" d={d}/></svg>
              ))}
              <span class="fl__name">Piano roll - FL Keys</span>
              <svg class="fl__more" viewBox="0 0 6.5 40"><path d="M0 15 6.3 21.5 0 28Z"/></svg>
            </div>
            <div class="fl__window">
              <svg class="fl__ghost" viewBox="0 0 28 40">
                <path d="M9.6 15h5.2v3H9.6zM5.6 21h5.2v3H5.6zM1.7 27h5.2v3H1.7z"/>
                <path class="o" d="M22.1 15.5h4.2v2h-4.2zM18.1 21.5h4.2v2h-4.2zM14.2 27.5h4.2v2h-4.2z"/>
              </svg>
              <svg class="fl__min" viewBox="0 0 12.4 40"><path d="M0 16h12.4v3H0z"/></svg>
              <svg class="fl__max" viewBox="0 0 14 40"><path fill-rule="evenodd" d="M0 16h14v11H0zM1.5 19v6h11v-6z"/></svg>
              <svg class="fl__close" viewBox="26 -3 28 80"><path fill-rule="evenodd" d={flIcons.close}/></svg>
            </div>
          </div>
          <div class="fl__top">
            <!-- The note-colour swatch in the corner, cut on the slant, with the portamento and slide marks in it. -->
            <svg class="fl__swatch" viewBox="0 0 104 59" preserveAspectRatio="none">
              <clipPath id="fl-swatch"><path d="M0 59V51L22.2 6.6A12 12 0 0 1 32.9 0H104V59Z"/></clipPath>
              <path class="cut" d="M-3 -3H35V51H-3Z"/>
              <path class="edge" d="M0 60V51L22.2 6.6A12 12 0 0 1 32.9 0H104"/>
              <path class="face" clip-path="url(#fl-swatch)" d="M0 59V51L22.2 6.6A12 12 0 0 1 32.9 0H104V59Z"/>
              <path class="mark" d="M79.3 21H84.6L90.2 10.5H96.8"/>
              <path class="mark mark--slide" d="M80 49.5h14.6v-14H91z"/>
            </svg>
            <div class="fl__hscroll">
              <svg class="fl__btn" viewBox="0 0 29 29"><path d={CHEVRON}/></svg>
              <span class="fl__track"><i class="fl__thumb"></i></span>
              <svg class="fl__btn fl__btn--right" viewBox="0 0 29 29"><path d={CHEVRON}/></svg>
            </div>
            <svg class="fl__btn fl__btn--dot" viewBox="0 0 29 29"><rect x="13" y="12" width="3" height="5"/></svg>
            <div class="fl__ruler">
              {[1, 2].map(bar => <span style={`left:${pct((bar - 1) * 16, STEPS)}`}><b>{bar}</b></span>)}
            </div>
            <div class="fl__vscroll">
              <svg class="fl__btn fl__btn--up" viewBox="0 0 29 29"><path d={CHEVRON}/></svg>
              <span class="fl__track"><i class="fl__thumb"></i></span>
              <svg class="fl__btn fl__btn--down" viewBox="0 0 29 29"><path d={CHEVRON}/></svg>
            </div>
            <div class="fl__keys">
              {whiteKeys.map(({ midi, top, height, label }) => (
                <span class:list={['wkey', { 'wkey--c': label }]} style={`top:calc(var(--row) * ${top});height:calc(var(--row) * ${height})`} data-key={midi}>
                  {label && <b>{label}</b>}
                </span>
              ))}
              {pitches.filter(isBlack).map(midi => <span class="bkey" style={`top:calc(var(--row) * ${rowOf(midi)})`} data-key={midi}></span>)}
            </div>
            <div class="fl__grid">
              {pitches.filter(isBlack).map(midi => <i class="fl__shade" style={`top:calc(var(--row) * ${rowOf(midi)})`}></i>)}
              <i class="fl__lines fl__lines--rows"></i>
              {notes.map(({ step, length, midi }) => (
                <span class="note" style={`left:${pct(step, STEPS)};top:calc(var(--row) * ${rowOf(midi)});width:${pct(length, STEPS)}`}
                  data-step={step} data-key={midi}><b>{nameOf(midi)}</b></span>
              ))}
            </div>
          </div>
          <div class="fl__split"><i></i></div>
          <div class="fl__bottom">
            <div class="fl__target"><span><b>Control</b></span><svg viewBox="0 0 6.5 13"><path d="M0 0 6.3 6.5 0 13Z"/></svg></div>
            <div class="fl__editor">
              <div class="fl__events">
                <i class="fl__lines fl__lines--quarters"></i>
                <span class="fl__lane"><b>Velocity</b></span>
                {notes.map(({ step, length, velocity }) => (
                  <span class="vel" style={`left:${pct(step, STEPS)};width:${pct(length, STEPS)};height:${(velocity / 135 * 100).toFixed(2)}%`} data-step={step}>
                    <i class="vel__stem"></i><i class="vel__head"></i>
                  </span>
                ))}
              </div>
              <div class="fl__zoom">
                <svg class="fl__btn" viewBox="0 0 29 29"><rect x="13.2" y="14" width="2.6" height="1"/></svg>
                <span class="fl__track"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>
    </div>
    <i class="studio__scan" aria-hidden="true" data-studio-scan></i>
    <canvas class="studio__flight" aria-hidden="true" width="1" height="1" data-studio-flight></canvas>
  </div>
</section>
<!-- What comes after the chapter (the way out of the page) stands on the rest of the same Playlist, at the
     same half light, so FL Studio's screen carries on under it instead of ending in black. -->
{Astro.slots.has('default') && (
  <div class="studio__after" data-studio-after>
    <PlaylistBackdrop tail />
    <div class="studio__out"><slot /></div>
  </div>
)}
<style>
  .studio { position: relative; background: var(--dark); color: var(--on-dark); }
  .studio__stage { position: relative; min-height: 100svh; display: grid; overflow: clip; isolation: isolate; }
  .studio__wipe { display: grid; min-width: 0; }
  .studio__world {
    position: relative; isolation: isolate; min-width: 0;
    display: grid; justify-items: center; align-content: center;
    gap: clamp(2rem, 5svh, 3.5rem); padding-top: max(5.25rem, 10svh);
  }
  .studio[data-held] { height: calc(max(250svh, 100svh + var(--studio-fill-travel, 0px)) + var(--studio-handoff, 0px)); }
  .studio[data-held] .studio__stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .studio[data-held] .studio__wipe { overflow: hidden; min-height: 0; }
  .studio[data-held] .studio__world { min-height: 0; grid-template-rows: auto minmax(0, 1fr); align-content: stretch; }
  /* Joined to the instruments (handoff.ts): this stage lies over theirs, see-through until the playhead has crossed it. */
  .studio[data-joined] { margin-top: calc(-1 * var(--studio-overlap, 0px)); background: none; }
  /* Nothing of the stage itself takes the pointer, so the guitar underneath can still be turned; FL Studio's
     own content does wherever the playhead has uncovered it (the rest is clipped away, hit-testing included). */
  .studio[data-joined] { pointer-events: none; }
  .studio[data-joined] .studio__world { pointer-events: auto; will-change: transform; }
  .studio[data-joined] .studio__wipe { will-change: transform, opacity; }
  .studio__scan, .studio__flight { display: none; }
  /* The shapes in flight (handoff.ts) are drawn on the screen itself: held by the viewport, as the instruments'
     stage is, and not by this one, which goes down the page when a scroll is thrown back past the hand-off's
     start. Its place and size are the held stage's (set by the script); shown only while the chapter is near. */
  .studio[data-joined] .studio__flight {
    display: block; position: fixed; top: 0; left: 0; width: 100%; height: 100svh;
    pointer-events: none; visibility: hidden;
  }
  /* FL's playhead, as in the Playlist behind (PlaylistBackdrop.astro), with the light it throws on what it has passed. */
  .studio[data-joined] .studio__scan {
    display: block; position: absolute; top: 0; bottom: 0; left: -1px; width: 1px; opacity: 0;
    background: #a1ce57; box-shadow: -2px 0 4px #94c239; pointer-events: none; will-change: transform, opacity;
  }
  .studio[data-joined] .studio__scan::before {
    content: ''; position: absolute; inset: 0 0 0 auto; width: clamp(48px, 9vw, 140px);
    background: linear-gradient(90deg, transparent, #b4ff9314 70%, #b4ff932e);
  }
  /* The words stand on black, as the instruments' do; under them the Playlist comes up at half light, so the
     piano roll is the one lit thing on the screen. One veil over the Playlist, eased with no edge to see. */
  .studio__world::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(rgb(0 0 0 / 1.000) 14.0%, rgb(0 0 0 / 0.998) 17.4%, rgb(0 0 0 / 0.988) 20.9%, rgb(0 0 0 / 0.965) 24.3%, rgb(0 0 0 / 0.928) 27.7%, rgb(0 0 0 / 0.877) 31.1%, rgb(0 0 0 / 0.816) 34.6%, rgb(0 0 0 / 0.750) 38.0%, rgb(0 0 0 / 0.684) 41.4%, rgb(0 0 0 / 0.623) 44.9%, rgb(0 0 0 / 0.572) 48.3%, rgb(0 0 0 / 0.535) 51.7%, rgb(0 0 0 / 0.512) 55.1%, rgb(0 0 0 / 0.502) 58.6%, rgb(0 0 0 / 0.500) 62.0%);
  }
  .studio__after {
    position: relative; isolation: isolate; overflow: clip;
    display: grid; place-items: center;
    padding-block: clamp(4rem, 12vw, 8rem);
    background: var(--dark);
  }
  .studio__after::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(0 0 0 / 0.5); pointer-events: none; }
  /* The piano roll's shadow reaches past the bottom of its screen: the rest of it falls here, from where the
     window stands (write-beat.ts measures it), so the screen's edge never shows as a line. */
  .studio__after[data-placed]::before {
    content: ''; position: absolute; pointer-events: none;
    left: var(--fl-x); top: calc(var(--fl-y) - var(--studio-screen)); width: var(--fl-w); height: var(--fl-h);
    box-shadow: 0 2px 6px #0006, 0 50px 110px -18px #000;
  }
  .studio__out { position: relative; }
  .studio__words { width: calc(100% - 2 * var(--gutter)); --on-dark-2: #e0e5e9; }
  .studio__desktop {
    position: relative; isolation: isolate; width: 100%; min-height: 0;
    display: grid; justify-items: center; align-items: center;
    padding: clamp(1.5rem, min(4.5vw, 6svh), 4.5rem) var(--gutter) clamp(1rem, 3svh, 2rem);
  }
  /* The window is sized from the room it is given: all of it when the screen is held, the width otherwise. */
  .roll { width: min(100%, 62rem); display: grid; place-items: center; container-type: inline-size; }
  .studio[data-held] .roll { align-self: stretch; container-type: size; }

  /* FL's labels are set in Segoe UI. Where that is missing, a subset of Selawik stands in: Microsoft's open
     font with Segoe's metrics (SIL OFL 1.1), cut down to the letters these labels use. */
  @font-face { font-family: 'Roll Sans'; src: url('./roll-sans.woff2') format('woff2'); font-display: block; }

  /* FL Studio's piano roll window. Lengths are pixels of Image-Line's screenshot times --u; the colours are sampled from it. */
  .fl {
    --u: clamp(.5px, min((100cqh - 7px) / 600, 100cqw / 600), 1px);
    --row: calc(22 * var(--u)); --step: min(calc(30 * var(--u)), (100cqw - 149 * var(--u) - 6px) / var(--steps));
    --keys: calc(104 * var(--u)); --sb: calc(29 * var(--u)); --tool: calc(40 * var(--u)); --ruler: calc(29 * var(--u));
    --split: calc(13 * var(--u)); --events: calc(128 * var(--u)); --rim: calc(8 * var(--u));
    --frame: #4e585e; --pane: #293238; --ink: #f2f8fc; --grid: #42545f;
    box-sizing: border-box; width: calc(var(--keys) + var(--step) * var(--steps) + var(--sb) + 2 * var(--rim) + 6px);
    padding: 0 var(--rim) var(--rim); border: 1px solid #374146; position: relative;
    background: var(--frame); color: var(--ink); box-shadow: 0 0 0 1px #0009, 0 2px 6px #0006, 0 50px 110px -18px #000;
    font: 400 calc(20 * var(--u)) / 1 'Segoe UI', 'Roll Sans', system-ui, sans-serif; letter-spacing: .02em;
    -webkit-text-stroke: calc(.25 * var(--u)) currentColor; text-align: left;
    transform-origin: 50% 60%; user-select: none;
  }
  /* Whole pixels, so every line of the grid lands on one. */
  @supports (width: round(down, 1.5px, 1px)) {
    .fl {
      --row: round(down, calc(22 * var(--u)), 2px);
      --step: round(down, min(calc(30 * var(--u)), (100cqw - 149 * var(--u) - 6px) / var(--steps)), 1px);
      --keys: round(down, calc(104 * var(--u)), 1px); --sb: round(down, calc(29 * var(--u)), 1px);
      --tool: round(down, calc(40 * var(--u)), 1px); --ruler: round(down, calc(29 * var(--u)), 1px);
      --split: round(down, calc(13 * var(--u)), 1px); --events: round(down, calc(128 * var(--u)), 4px);
      --rim: round(down, calc(8 * var(--u)), 1px);
    }
  }
  /* The resize grip in the corner. */
  .fl::after {
    content: ''; position: absolute; right: 0; bottom: 0; width: var(--rim); height: var(--rim);
    background: linear-gradient(to bottom right, transparent 50%, #374146 50%);
  }
  .fl svg { display: block; flex: none; fill: currentColor; }
  /* A label whose baseline sits an exact distance under its box's top, whatever the font's own metrics. */
  .fl__name::before, .fl__target span::before, .fl__lane::before, .fl__ruler span::before, .note::before {
    content: ''; display: inline-block; height: var(--base);
  }
  .fl b { font-weight: inherit; }
  /* Note names and bar numbers are the same face drawn narrow. */
  .fl__ruler b, .fl__keys b, .note b { display: inline-block; transform: scaleX(.78); transform-origin: 0 50%; }

  /* The title bar: the tools, the target channel, the window's buttons. */
  .fl__bar { display: flex; height: calc(var(--tool) + 1px); margin-inline: calc(-1 * var(--rim)); border-top: 1px solid #555f64; }
  /* Tools that do not fit a narrow window drop out whole, the title first. */
  .fl__tools { flex: 1; min-width: 0; height: var(--tool); display: flex; flex-wrap: wrap; overflow: hidden; padding-inline-start: calc(5.7 * var(--u)); }
  .fl__tool { width: calc(32.6 * var(--u)); height: var(--tool); }
  .fl__tool.is-dim { color: #e1e7ec; }
  .fl__tool.is-mint { color: #94ffc4; }
  .fl__tool.is-lime { color: #b4ff93; }
  .fl__tool.is-yellow { color: #ffe24e; }
  .fl__tool.leads-group { margin-inline-start: calc(12.8 * var(--u)); }
  .fl__tool.leads-play { margin-inline-start: calc(6.7 * var(--u)); }
  .fl__name { --base: calc(var(--tool) / 2 + 7 * var(--u)); flex: none; height: var(--tool); margin-inline-start: calc(8.1 * var(--u)); line-height: 0; white-space: nowrap; }
  .fl__more { width: calc(6.5 * var(--u)); height: var(--tool); margin-inline-start: calc(9.5 * var(--u)); color: #919a9e; }
  .fl__window { flex: none; display: flex; padding-inline-end: calc(13.5 * var(--u)); }
  .fl__window svg { height: var(--tool); }
  .fl__ghost { width: calc(28 * var(--u)); }
  .fl__ghost .o { fill: none; stroke: #a3abb0; stroke-width: 1; }
  .fl__min { width: calc(12.4 * var(--u)); margin-inline-start: calc(13.9 * var(--u)); }
  .fl__max { width: calc(14 * var(--u)); margin-inline-start: calc(15.5 * var(--u)); }
  .fl__close { width: calc(14 * var(--u)); margin-inline-start: calc(14.2 * var(--u)); }

  /* The panes sit on the dark of their borders, a pixel apart. */
  .fl__top, .fl__editor { display: grid; gap: 1px; padding: 1px; background: var(--pane); }
  .fl__top {
    grid-template-columns: var(--keys) calc(var(--step) * var(--steps)) var(--sb);
    grid-template-rows: var(--sb) var(--ruler) calc(var(--row) * var(--rows) - 1px);
  }
  .fl__swatch { grid-area: 1 / 1 / 3 / 2; width: 100%; height: 100%; overflow: visible; }
  .fl__swatch path { vector-effect: non-scaling-stroke; }
  .fl__swatch .cut { fill: var(--frame); }
  .fl__swatch .edge { fill: none; stroke: var(--pane); stroke-width: 2; }
  .fl__swatch .face { fill: #a8e1b0; stroke: #d2ffda; stroke-width: 2; }
  .fl__swatch .mark { fill: none; stroke: #d2ffda; stroke-width: 3; stroke-linejoin: round; vector-effect: none; }
  .fl__swatch .mark--slide { fill: #d2ffda; stroke: none; }

  /* Scroll bars: square buttons, a dithered track, a thumb. */
  .fl__btn { width: var(--sb); height: var(--sb); background: #616b71; box-shadow: inset 0 0 0 1px #768086; color: #232d32; }
  .fl__btn path { fill: none; stroke: currentColor; stroke-width: 1.7; }
  .fl__btn--up { rotate: 90deg; }
  .fl__btn--right { rotate: 180deg; }
  .fl__btn--down { rotate: 270deg; }
  .fl__btn--dot { grid-area: 1 / 3; }
