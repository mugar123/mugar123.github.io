---
import { getCollection } from 'astro:content';
import { publishedPosts } from '@/lib/posts';

const path = Astro.url.pathname;
// Writing joins the nav with its first published entry; until then /writing only holds the empty state.
const hasPosts = publishedPosts(await getCollection('writing')).length > 0;
const items = [
  { href: '/#in-orbit', label: 'Work' },
  ...(hasPosts ? [{ href: '/writing', label: 'Writing' }] : []),
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
];
---
<nav class="nav container" aria-label="Primary">
  <a class="mono mono--ink" href="/">Nicolás Muñoz</a>
  <ul>
    {items.map((i) => (
      <li><a class="mono" href={i.href} aria-current={path.startsWith(i.href.split('#')[0] ?? i.href) && i.href !== '/#in-orbit' ? 'page' : undefined}>{i.label}</a></li>
    ))}
  </ul>
</nav>
<style>
  .nav { display: flex; justify-content: space-between; align-items: center; padding-block: var(--space-4); }
  ul { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  li { display: flex; } /* drop the 19 px body line box so the links share the brand's baseline */
  a { text-decoration: none; }
  a:hover, a[aria-current="page"] { color: var(--ink); text-decoration: underline; }
</style>
