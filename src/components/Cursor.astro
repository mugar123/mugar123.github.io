---
---
<div class="cursor" aria-hidden="true" hidden>
  <span class="cursor__dot"></span>
  <span class="cursor__ring"></span>
</div>

<script>
  // Shown only while both preferences allow it; live changes (reduced motion switched on, a mouse unplugged) tear it down.
  const root = document.querySelector<HTMLElement>('.cursor');
  const mm = typeof window.matchMedia === 'function';
  if (root && mm) {
    const html = document.documentElement;
    const fine = matchMedia('(pointer: fine)');
    const calm = matchMedia('(prefers-reduced-motion: no-preference)');
    const dot = root.querySelector<HTMLElement>('.cursor__dot')!;
    const ring = root.querySelector<HTMLElement>('.cursor__ring')!;
    let x = 0, y = 0, rx = 0, ry = 0, raf = 0, seen = false, on = false;
    const out = () => root.classList.add('is-out');
    const back = () => root.classList.remove('is-out');
    const tick = () => {
      rx += (x - rx) * 0.18; ry += (y - ry) * 0.18;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      raf = Math.abs(x - rx) + Math.abs(y - ry) > 0.2 ? requestAnimationFrame(tick) : 0;
    };
    const move = (e: PointerEvent) => {
      x = e.clientX; y = e.clientY;
      if (!seen) { rx = x; ry = y; seen = true; } // the ring starts under the pointer, not flying in from a corner
      back();
      dot.style.transform = `translate(${x}px, ${y}px)`;
      const t = e.target as Element | null;
      root.classList.toggle('is-link', Boolean(t?.closest('a, button, [role="button"]')));
      root.classList.toggle('is-text', Boolean(t?.closest('input, textarea, [contenteditable]')));
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const enable = () => {
      on = true; seen = false;
      root.hidden = false; out(); // nothing to show until the first pointermove places it
      html.classList.add('has-cursor');
      addEventListener('pointermove', move, { passive: true });
      // pointerleave/enter do not bubble to window; the root element receives them when the pointer leaves the viewport.
      html.addEventListener('pointerleave', out);
      html.addEventListener('pointerenter', back);
    };
    const disable = () => {
      on = false;
      root.hidden = true;
      html.classList.remove('has-cursor');
      removeEventListener('pointermove', move);
      html.removeEventListener('pointerleave', out);
      html.removeEventListener('pointerenter', back);
      cancelAnimationFrame(raf); raf = 0;
    };
    const sync = () => {
      const ok = fine.matches && calm.matches;
      if (ok && !on) enable(); else if (!ok && on) disable();
    };
    fine.addEventListener('change', sync);
    calm.addEventListener('change', sync);
    sync();
  }
</script>

<style is:global>
  html.has-cursor, html.has-cursor a, html.has-cursor button { cursor: none; }
  html.has-cursor input, html.has-cursor textarea, html.has-cursor [contenteditable] { cursor: auto; }
  .cursor { position: fixed; inset: 0; pointer-events: none; z-index: 1000; }
  .cursor[hidden] { display: none; }
  .cursor__dot, .cursor__ring { position: absolute; top: 0; left: 0; border-radius: 50%; will-change: transform; }
  .cursor__dot { width: 6px; height: 6px; margin: -3px 0 0 -3px; background: var(--accent); }
  .cursor__ring { width: 28px; height: 28px; margin: -14px 0 0 -14px; border: 1px solid var(--ink);
    transition: width var(--dur) var(--ease), height var(--dur) var(--ease), margin var(--dur) var(--ease), background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .cursor.is-link .cursor__ring { width: 40px; height: 40px; margin: -20px 0 0 -20px; background: rgba(226, 64, 28, 0.12); border-color: var(--accent); }
  .cursor.is-text .cursor__ring, .cursor.is-text .cursor__dot, .cursor.is-out .cursor__ring, .cursor.is-out .cursor__dot { opacity: 0; }
  @media print { .cursor { display: none; } }
</style>
