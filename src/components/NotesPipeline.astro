---
/**
 * Inside the LaTeX converter, in the page's own bento: six tiles that say what the old long form said
 * (the crew, the eight steps, the fidelity marks, the figures, the delivery and the numbers), each with
 * one small widget. Facts from the pipeline's skill files and the two book manifests (5 November 2026).
 * Dark tiles on the converter's black stage, so the section carries straight on from the scan above.
 */

const steps = [
  ['Triage', 'text layer or vision'],
  ['Index', 'every page in the manifest'],
  ['Literal', 'exactly as written'],
  ['Format', 'my template, page by page'],
  ['Figures', 'redrawn in TikZ'],
  ['Compile', 'lint, then pdflatex twice'],
  ['Review', 'against the original'],
  ['Deliver', 'a clean PDF and a marked one'],
];
---
<section class="lx section section--dark" aria-labelledby="lx-title">
  <header class="lx-intro container--wide">
    <h2 class="lx-title" id="lx-title">How it works.</h2>
  </header>

  <div class="lx-bento container--wide">
    <!-- The crew: one orchestrator above, three kinds of subagent below. -->
    <article class="lx-tile lx-tile--half lx-tile--crew">
      <h3 class="lx-tile__title">One Claude orchestrates. Subagents do the work.</h3>
      <p class="lx-tile__text">The orchestrator reads every page, hands out the blocks and checks what comes back against the original. It never transcribes a line itself, and runs up to five subagents at once.</p>
      <div class="lx-crew" data-draw>
        <p class="lx-node lx-node--lead"><img src="/toolkit/claude.svg" alt="" width="64" height="64" /><span><b>Orchestrator</b><em>Opus 5</em></span></p>
        <ul class="lx-crew__team" aria-label="Subagents">
          <li class="lx-node"><b>Transcribers</b><em>Sonnet 5</em></li>
          <li class="lx-node"><b>Figure drawers</b><em>Opus 5.5</em></li>
          <li class="lx-node"><b>Compiler</b><em>pdflatex</em></li>
        </ul>
      </div>
    </article>

    <!-- The numbers, on the dark tile, as PaperTok's 748. -->
    <article class="lx-tile lx-tile--half lx-tile--stat">
      <p class="lx-big">969<span> pages</span></p>
      <p class="lx-stat-text">compiled to LaTeX so far.</p>
      <dl class="lx-minis">
        <div><dt>figures in TikZ</dt><dd>624</dd></div>
        <div><dt>chapters</dt><dd>27</dd></div>
        <div><dt>compile errors</dt><dd>0</dd></div>
      </dl>
    </article>

    <!-- The run: eight checks that tick, in order, the first time the list is on screen. -->
    <article class="lx-tile lx-tile--half lx-tile--run">
      <h3 class="lx-tile__title">Eight steps. Each one can fail out loud.</h3>
      <p class="lx-tile__text">A step is done when its check passes. The next one waits until it does.</p>
      <ol class="lx-steps" data-draw>
        {steps.map(([name, gist], i) => (
          <li style={`--i: ${i}`}>
            <span class="lx-check" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" /><path d="M6 10.4l2.6 2.6L14 7.6" pathLength="1" /></svg></span>
            <b>{name}</b><span class="lx-steps__gist">{gist}</span>
          </li>
        ))}
      </ol>
    </article>

    <!-- The marks: one flag in the preamble, flipped by a segmented control (two native radios). -->
    <article class="lx-tile lx-tile--half lx-tile--marks">
      <h3 class="lx-tile__title">Nothing is fixed in silence.</h3>
      <p class="lx-tile__text">Every correction and every addition carries a mark and the page it came from. One flag hides them all for the clean copy.</p>
      <ul class="lx-chips" aria-label="The four marks">
        <li class="is-used"><code>\correction</code></li><li class="is-used"><code>\added</code></li><li><code>\review</code></li><li><code>\omitted</code></li>
      </ul>
      <div class="lx-marks">
        <input class="lx-radio lx-radio--review" type="radio" name="lx-mode" id="lx-review" checked />
        <input class="lx-radio lx-radio--clean" type="radio" name="lx-mode" id="lx-clean" />
        <div class="lx-seg" role="presentation"><span class="lx-seg__thumb" aria-hidden="true"></span><label class="lx-seg__opt lx-seg__opt--review" for="lx-review">Review</label><label class="lx-seg__opt lx-seg__opt--clean" for="lx-clean">Clean</label></div>
        <p class="lx-pre"><code>\usepackage<span class="lx-pre__flag">[clean]</span>&#123;apuntes-nmg&#125;</code></p>
        <div class="lx-paper" aria-label="A theorem as compiled, with its marks">
          <div class="lx-paper__row">
            <div class="lx-paper__text">
              <p><b>Theorem 1</b> (Change of variables)<b>.</b></p>
              <math display="block">
                <msub><mo>∫</mo><mi>V</mi></msub><mi>f</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mspace width="0.17em" /><mi>d</mi><mi>y</mi>
                <mo>=</mo>
                <msub><mo>∫</mo><mi>U</mi></msub><mi>f</mi><mo stretchy="false">(</mo><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mspace width="0.17em" />
                <mrow class="lx-fix"><mo form="prefix" stretchy="false">|</mo><mi>det</mi><mspace width="0.17em" /><mi>D</mi><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo form="postfix" stretchy="false">|</mo></mrow><mspace width="0.17em" /><mi>d</mi><mi>x</mi>
              </math>
            </div>
            <p class="lx-paper__note"><code>\correction</code> absolute value was missing</p>
          </div>
          <div class="lx-paper__row">
            <p class="lx-paper__text lx-fix">Since <math><mi>φ</mi></math> is a diffeomorphism, <math><mi>det</mi><mspace width="0.17em" /><mi>D</mi><mi>φ</mi><mo>≠</mo><mn>0</mn></math>.</p>
            <p class="lx-paper__note"><code>\added</code> step skipped in the notebook</p>
          </div>
        </div>
      </div>
    </article>

    <!-- The figures: the converter's own figure, drawn once like a plotter pen. -->
    <article class="lx-tile lx-tile--half lx-tile--fig">
      <h3 class="lx-tile__title">Every figure, redrawn in TikZ.</h3>
      <p class="lx-tile__text">One agent per figure rebuilds it from measured coordinates, never pasted as an image. A graph is checked against its formula, not against how it looks.</p>
      <figure class="lx-fig" data-draw>
        <svg viewBox="0 0 300 120" role="img" aria-label="The rectangle U in the (r, θ) plane mapped by φ onto the disc V">
          <path class="lx-fig__rg" d="M20 88 H84 V36 H20 Z" pathLength="1" />
          <path class="lx-fig__ax" d="M12 104 H118" pathLength="1" />
          <path class="lx-fig__ax" d="M20 110 V8" pathLength="1" />
          <path class="lx-fig__ax lx-fig__tip" d="M114 101 L119 104 L114 107 M17 13 L20 8 L23 13" />
          <path class="lx-fig__ax" d="M126 58 Q 154 44 182 58" pathLength="1" />
          <path class="lx-fig__ax lx-fig__tip" d="M176 53.5 L183 58.5 L176 61.5" />
          <circle class="lx-fig__rg" cx="244" cy="61" r="40" pathLength="1" />
          <g class="lx-fig__labels">
            <text class="it" x="45" y="67">U</text>
            <text class="it" x="80" y="118">R</text><text x="0" y="40">2π</text>
            <text class="it" x="112" y="118">r</text><text class="it" x="26" y="13">θ</text>
            <text class="it" x="150" y="42">φ</text>
            <text class="it" x="236" y="66">V</text>
          </g>
        </svg>
        <figcaption><b>Figure 1.</b> Polar coordinates, <math><mi>φ</mi><mo>:</mo><mi>U</mi><mo>→</mo><mi>V</mi></math>.</figcaption>
      </figure>
    </article>

    <!-- The delivery: two PDFs side by side. -->
    <article class="lx-tile lx-tile--half lx-tile--pdfs">
      <h3 class="lx-tile__title">Two PDFs. Zero errors, or it doesn’t ship.</h3>
      <p class="lx-tile__text">A clean copy to study from, and one that lists every intervention with its page. Up to three rounds of compile, render and compare, then a human looks.</p>
      <div class="lx-pdfs" aria-hidden="true">
        <div class="lx-pdf">
          <div class="lx-pdf__sheet"><i></i><i></i><i class="s"></i><i class="eq"></i><i></i><i class="s"></i><i></i><i class="m"></i></div>
          <p class="lx-pdf__name">notes.pdf</p>
        </div>
        <div class="lx-pdf lx-pdf--review">
          <div class="lx-pdf__sheet"><i></i><i class="b"></i><i class="s"></i><i class="eq b"></i><i></i><i class="s"></i><i class="tbl"></i><i class="tbl"></i><i class="tbl"></i></div>
          <p class="lx-pdf__name">notes, marked.pdf</p>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  /* ===== theme ===== */
  /* Tiles a step lighter than the stage; wells a step lighter than the tiles. */
  .lx {
    --lx-tile: var(--dark-tile);
    --lx-ink: var(--on-dark);
    --lx-ink-2: var(--on-dark-2);
    --lx-line: rgba(255, 255, 255, 0.14);
    --lx-well: rgba(255, 255, 255, 0.07);
    --lx-accent: var(--link-on-dark);
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  /* ===== frame: the page's bento ===== */
  .lx-intro { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .lx-title { font-size: clamp(2.25rem, 4.4vw, 3.5rem); line-height: 1.05; font-weight: 600; letter-spacing: -0.02em; }

  .lx-bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .lx-tile {
    display: flex; flex-direction: column; gap: 0.75rem;
    min-width: 0; padding: 2rem;
    border-radius: 1.75rem;
    background: var(--lx-tile);
  }
  .lx-tile--half { grid-column: span 2; }
  .lx-tile__title { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.12; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; }
  .lx-tile__text { max-width: 32rem; font-size: 1.0625rem; line-height: 1.47; color: var(--lx-ink-2); text-wrap: pretty; }

  /* ===== crew ===== */
  /* The structure is the diagram: the lead above, a stem, a bus, a drop into each of the three. */
  .lx-crew { --gap: 0.75rem; margin-top: auto; padding-top: 1.5rem; display: grid; justify-items: center; }
  .lx-node {
    display: grid; gap: 0.125rem; justify-items: center; text-align: center;
    padding: 0.75rem 0.875rem;
    border-radius: 1rem;
    background: var(--lx-well);
  }
  .lx-node b { font-size: 0.9375rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.005em; }
  .lx-node em { font-style: normal; font-size: 0.8125rem; line-height: 1.3; color: var(--lx-ink-2); }
  .lx-node--lead { position: relative; display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.125rem 0.75rem 0.875rem; text-align: left; }
  .lx-node--lead span { display: grid; gap: 0.125rem; }
  .lx-node--lead img { width: 2rem; height: 2rem; }
  .lx-node--lead b { font-size: 1.0625rem; }
  /* The stem. */
  .lx-node--lead::after {
    content: ''; position: absolute; left: 50%; top: 100%;
    width: 1px; height: 1.25rem; background: var(--lx-line);
  }
  .lx-crew__team {
    position: relative; width: 100%;
    list-style: none; margin: 1.25rem 0 0; padding: 1.25rem 0 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap);
  }
  /* The bus: from the first column's centre to the last's. */
  .lx-crew__team::before {
    content: ''; position: absolute; top: 0;
    left: calc((100% - 2 * var(--gap)) / 6); right: calc((100% - 2 * var(--gap)) / 6);
    height: 1px; background: var(--lx-line);
  }
  .lx-crew__team .lx-node { position: relative; }
  /* Each drop. */
  .lx-crew__team .lx-node::before {
    content: ''; position: absolute; left: 50%; bottom: 100%;
    width: 1px; height: 1.25rem; background: var(--lx-line);
  }

  /* ===== numbers ===== */
  .lx-tile--stat { gap: 0; }
  .lx-big { font-size: clamp(5rem, 10vw, 7.5rem); line-height: 0.9; font-weight: 600; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .lx-big span { font-size: 0.3em; letter-spacing: -0.005em; color: var(--on-dark-2); }
  .lx-stat-text { margin-top: 0.75rem; font-size: 1.1875rem; line-height: 1.32; font-weight: 500; color: var(--on-dark-2); }
  .lx-minis {
    margin: auto 0 0; padding-top: 2rem;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem;
  }
  .lx-minis div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.375rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .lx-minis dd { margin: 0; font-size: clamp(2rem, 3.4vw, 2.75rem); line-height: 1; font-weight: 600; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .lx-minis dt { font-size: 0.875rem; line-height: 1.3; color: var(--on-dark-2); }

  /* ===== run ===== */
  .lx-steps { list-style: none; margin: auto 0 0; padding: 1.25rem 0 0; display: grid; }
  .lx-steps li {
    display: grid; grid-template-columns: 1.375rem auto minmax(0, 1fr); align-items: center; column-gap: 0.75rem;
    padding-block: 0.5625rem;
    border-top: 1px solid var(--lx-line);
    font-size: 0.9375rem; line-height: 1.35;
  }
  .lx-steps li:last-child { border-bottom: 1px solid var(--lx-line); }
  .lx-steps b { font-weight: 600; }
  .lx-steps__gist { justify-self: end; text-align: right; color: var(--lx-ink-2); }
  .lx-check svg { width: 1.375rem; height: 1.375rem; overflow: visible; }
  .lx-check circle { fill: var(--lx-accent); }
  .lx-check path { fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ===== marks ===== */
  .lx-marks { position: relative; margin-top: auto; padding-top: 1.25rem; display: grid; gap: 0.875rem; }
  .lx-radio { position: absolute; top: 0; left: 0; width: 1px; height: 1px; margin: 0; opacity: 0; clip-path: inset(50%); }
  /* The site's segmented control. */
  .lx-seg {
    position: relative;
    display: grid; grid-template-columns: 1fr 1fr;
    width: 12rem; height: 2rem; padding: 0.125rem;
    border-radius: 0.5625rem;
    background: rgba(255, 255, 255, 0.1);
  }
  .lx-seg__thumb {
    position: absolute; top: 0.125rem; bottom: 0.125rem; left: 0.125rem;
    width: calc((100% - 0.25rem) / 2);
    border-radius: 0.4375rem;
    background: rgba(255, 255, 255, 0.22);
    transition: transform 200ms var(--ease-out);
  }
  .lx-seg__opt {
    position: relative; z-index: 1;
    display: grid; place-items: center;
    font: 500 0.8125rem/1 var(--font);
    color: var(--lx-ink-2);
    cursor: pointer; user-select: none; -webkit-user-select: none;
    transition: transform 120ms var(--ease-out), color 120ms var(--ease-out);
  }
  /* 44px to hit, 32px to see. */
  .lx-seg__opt::after { content: ''; position: absolute; inset: -0.375rem 0; }
  .lx-seg__opt:active { transform: scale(0.97); }
  .lx-radio--review:checked ~ .lx-seg .lx-seg__opt--review,
  .lx-radio--clean:checked ~ .lx-seg .lx-seg__opt--clean { color: var(--lx-ink); }
  .lx-radio--clean:checked ~ .lx-seg .lx-seg__thumb { transform: translateX(100%); }
  .lx-radio--review:focus-visible ~ .lx-seg .lx-seg__opt--review,
  .lx-radio--clean:focus-visible ~ .lx-seg .lx-seg__opt--clean { outline: 2px solid var(--blue); outline-offset: 1px; border-radius: 0.4375rem; }

  /* The preamble line: the cause of what the page shows. */
  .lx-pre { font: 400 0.8125rem/1.4 var(--mono); color: var(--lx-ink-2); }
  .lx-pre code { font: inherit; }
  .lx-pre__flag { display: none; color: var(--lx-accent); }
  .lx-radio--clean:checked ~ .lx-pre .lx-pre__flag { display: inline; }

  /* The page, white: it is the PDF. */
  .lx-paper {
    display: grid; gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.375rem 1.5rem;
    border-radius: 0.75rem;
    background: #fff; color: #111;
    font: 400 1rem/1.45 var(--math);
  }
  .lx-paper__row { display: grid; grid-template-columns: minmax(0, 1fr) 8rem; column-gap: 1rem; align-items: center; }
  .lx-paper__text { display: grid; gap: 0.375rem; margin: 0; }
  p.lx-paper__text { display: block; text-wrap: pretty; }
  .lx-paper__text p { margin: 0; }
  .lx-paper b { font-weight: 700; }
  .lx-paper math { font-size: 1.06em; }
  .lx-paper math[display="block"] { margin: 0; overflow-x: auto; overflow-y: hidden; }
  .lx-fix { color: var(--link); transition: color 160ms ease; }
  .lx-paper__note {
    padding-left: 0.625rem; border-left: 1px solid var(--link);
    font: 400 0.75rem/1.33 var(--font); letter-spacing: 0.01em; color: var(--link);
    text-wrap: balance;
    transition: opacity 160ms ease;
  }
  .lx-paper__note code { display: block; font: 400 0.6875rem/1.4 var(--mono); }
  .lx-radio--clean:checked ~ .lx-paper .lx-fix { color: inherit; }
  .lx-radio--clean:checked ~ .lx-paper .lx-paper__note { opacity: 0; }

  /* The four marks: the two the sample uses in the accent. */
  .lx-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .lx-chips li { padding: 0.375rem 0.625rem; border-radius: 0.5rem; background: var(--lx-well); font: 400 0.8125rem/1.2 var(--mono); color: var(--lx-ink-2); }
  .lx-chips li.is-used { color: var(--lx-accent); }

  /* ===== figures ===== */
  .lx-fig { margin: auto 0 0; padding-top: 1.5rem; display: grid; gap: 1rem; }
  .lx-fig svg { width: 100%; max-width: 30rem; height: auto; margin-inline: auto; overflow: visible; }
  .lx-fig path, .lx-fig circle { fill: none; stroke: currentColor; stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }
  .lx-fig .lx-fig__rg { fill: var(--lx-well); stroke-width: 1.1; }
  .lx-fig .lx-fig__ax { stroke-width: 0.9; }
  .lx-fig text { font-family: var(--math); font-size: 13px; fill: currentColor; stroke: none; }
  .lx-fig .it { font-style: italic; }
  .lx-fig figcaption { font: 400 0.9375rem/1.4 var(--math); text-align: center; color: var(--lx-ink-2); }
  .lx-fig figcaption b { font-weight: 700; color: var(--lx-ink); }

  /* ===== pdfs ===== */
  .lx-pdfs { margin-top: auto; padding-top: 1.75rem; display: flex; justify-content: center; gap: clamp(1.25rem, 4vw, 2.5rem); }
  .lx-pdf { width: min(42%, 10.5rem); display: grid; gap: 0.75rem; justify-items: center; }
  .lx-pdf__sheet {
    width: 100%; aspect-ratio: 1 / 1.414;
    display: grid; align-content: start; gap: 7%;
    padding: 16% 14%;
    border-radius: 0.375rem;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08), 0 0.75rem 1.5rem -0.75rem rgba(0, 0, 0, 0.25);
  }
  .lx-pdf__sheet i { display: block; height: 0.3125rem; border-radius: 1px; background: #d2d2d7; }
  .lx-pdf__sheet i.s { width: 62%; }
  .lx-pdf__sheet i.m { width: 80%; }
  .lx-pdf__sheet i.eq { width: 56%; margin-inline: auto; margin-block: 3%; background: #a1a1a6; }
  .lx-pdf__sheet i.b { background: var(--link); opacity: 0.75; }
  .lx-pdf__sheet i.tbl { height: 0.25rem; background: none; border-top: 1px solid #c7c7cc; border-radius: 0; }
  .lx-pdf__sheet i.tbl:first-of-type { margin-top: 6%; }
  .lx-pdf__name { font: 400 0.75rem/1.2 var(--mono); color: var(--lx-ink-2); }

  /* ===== smaller screens ===== */
  @media (max-width: 1080px) {
    /* Two by two: each tile takes one of the two columns. */
    .lx-bento { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .lx-tile--half { grid-column: span 1; }
    .lx-tile { padding: 1.75rem; }
    .lx-crew { --gap: 0.5rem; }
    .lx-node { padding: 0.625rem 0.375rem; }
    .lx-node b { font-size: 0.875rem; }
    .lx-paper__row { grid-template-columns: minmax(0, 1fr); row-gap: 0.375rem; }
    /* Stacked under their lines, hidden notes would leave holes: in the clean copy they leave the page. */
    .lx-radio--clean:checked ~ .lx-paper .lx-paper__note { display: none; }
    .lx-steps li { grid-template-columns: 1.375rem minmax(0, 1fr); row-gap: 0.125rem; }
    .lx-steps__gist { grid-column: 2; justify-self: start; text-align: left; font-size: 0.875rem; }
  }
  @media (max-width: 900px) {
    .lx-tile--half { grid-column: 1 / -1; }
    .lx-steps li { grid-template-columns: 1.375rem auto minmax(0, 1fr); }
    .lx-steps__gist { grid-column: auto; justify-self: end; text-align: right; font-size: 0.9375rem; }
  }
  @media (max-width: 620px) {
    .lx-bento { gap: 0.75rem; }
    .lx-tile { padding: 1.5rem; }
    .lx-crew { --gap: 0.5rem; }
    .lx-node { padding: 0.625rem 0.375rem; border-radius: 0.875rem; }
    .lx-node b { font-size: 0.8125rem; }
    .lx-node em { font-size: 0.75rem; }
    .lx-big { font-size: 5.5rem; }
    .lx-minis { gap: 0.875rem; }
    .lx-minis dd { font-size: 1.875rem; }
    .lx-minis dt { font-size: 0.8125rem; }
    .lx-steps li { grid-template-columns: 1.375rem minmax(0, 1fr); row-gap: 0.125rem; }
    .lx-steps__gist { grid-column: 2; justify-self: start; text-align: left; font-size: 0.875rem; }
    .lx-seg { width: 100%; }
    .lx-pre { font-size: 0.75rem; }
    .lx-paper { padding: 1rem 1rem 1.125rem; font-size: 0.875rem; }
  }

  /* ===== motion ===== */
  /* Once, the first time each widget is mostly on screen (scripts/scroll.ts adds .is-in to [data-draw]).
     Transforms, opacity and dash offsets only. Without the script, or with reduced motion, everything is
     simply there. */
  /* The crew: the stem drops, the bus runs across, each drop lands. */
  :global(html.js:not(.reduce)) .lx-crew .lx-node--lead::after { transform: scaleY(0); transform-origin: top; }
