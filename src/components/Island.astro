---
/**
 * The navigation as the Dynamic Island itself: an opaque black pill at the top, with the iPhone's
 * proportions (compact 124×36, radius = half the height), that grows into the links when hovered (fine
 * pointers) or tapped (touch) and shrinks back when left. The shape springs: a soft overshoot on the way
 * out, a quick damped settle on the way back, both interruptible since they are transitions and retarget
 * from wherever they are. The content fades and un-blurs a beat after the shape has started to move.
 * Sizes for the open state are measured by the script; without it the island is simply open.
 */
const links = [
  { href: '#projects', label: 'Projects' },
  { href: '#studies', label: 'Studies' },
  { href: '#how-i-work', label: 'How I work' },
  { href: '#contact', label: 'Contact' },
];
---
<nav class="island" data-island aria-label="Primary">
  <button class="island__hit" type="button" aria-expanded="false" aria-controls="island-menu" aria-label="Menu"></button>
  <span class="island__camera" aria-hidden="true"></span>
  <span class="island__light" aria-hidden="true"></span>
  <div class="island__inner" id="island-menu">
    {links.map((l) => <a class="island__link" href={l.href}>{l.label}</a>)}
  </div>
</nav>

<style>
  .island {
    --w: 124px; --h: 36px; --r: 18px;
    --open-w: 352px; --open-h: 56px; --open-r: 28px;
    --out: cubic-bezier(0.34, 1.25, 0.64, 1); /* a touch of overshoot as it grows */
    --back: cubic-bezier(0.32, 0.72, 0, 1); /* quick, damped, as it shrinks */
    position: fixed; top: 11px; left: 50%; z-index: 10;
    translate: -50% 0;
    width: var(--w); height: var(--h); border-radius: var(--r);
    background: #000;
    color: var(--on-dark);
    /* A soft shadow lifts it on the light pages. Over the black ones the script adds .is-on-dark: the
       island steps up to the dark-tile grey with a hairline ring, so it never melts into the page. */
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    transition: width 380ms var(--back), height 380ms var(--back), border-radius 380ms var(--back), background-color 200ms ease, box-shadow 200ms ease;
  }
  .island.is-on-dark { background: var(--dark-tile); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22); }
  .island__hit { position: absolute; inset: 0; border: 0; border-radius: inherit; background: none; cursor: pointer; }
  .island__hit:focus-visible { outline-offset: 3px; }
  /* The front camera, as it shows through the glass: a dark lens with a faint ring, on the right. */
  .island__camera {
    position: absolute; top: 50%; right: 22px; translate: 0 -50%;
    width: 12px; height: 12px; border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, #2c2c2e 0, #121214 45%, #050505 70%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07), 0 0 0 1px rgba(255, 255, 255, 0.035);
    transition: opacity 150ms ease;
    pointer-events: none;
  }
  .island.is-open .island__camera, :global(html:not(.js)) .island__camera { opacity: 0; }
  /* The green privacy light beside it, lit. Both hide while the island is open. */
  .island__light {
    position: absolute; top: 50%; right: 10px; translate: 0 -50%;
    width: 6px; height: 6px; border-radius: 50%;
    background: #30d158;
    box-shadow: 0 0 6px rgba(48, 209, 88, 0.9);
    transition: opacity 150ms ease;
    pointer-events: none;
  }
  .island.is-open .island__light, :global(html:not(.js)) .island__light { opacity: 0; }

  .island__inner {
    position: absolute; top: 50%; left: 50%; translate: -50% -50%;
    display: flex; align-items: center; gap: 2px; padding: 0 8px;
    white-space: nowrap;
    opacity: 0; filter: blur(6px); scale: 0.92;
    pointer-events: none;
    transition: opacity 150ms ease, filter 150ms ease, scale 150ms ease;
  }
  .island__link {
    display: block; padding: 8px 14px; border-radius: 20px;
    font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: var(--on-dark); text-decoration: none;
    transition: background-color 150ms ease;
  }
  .island__link:last-child { background: var(--on-dark); color: #000; margin-left: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .island__link:not(:last-child):hover { background: rgba(255, 255, 255, 0.14); }
  }
  /* Pressed: the link lights at once and fades on release, like a row in an iOS list. */
  .island__link:not(:last-child):active { background: rgba(255, 255, 255, 0.14); transition-duration: 0ms; }
  .island__link:last-child:active { background: #d2d2d7; transition-duration: 0ms; }

  /* Open. */
  .island.is-open, :global(html:not(.js)) .island {
    width: var(--open-w); height: var(--open-h); border-radius: var(--open-r);
    transition: width 600ms var(--out), height 600ms var(--out), border-radius 600ms var(--out);
  }
  .island.is-open .island__inner, :global(html:not(.js)) .island__inner {
    opacity: 1; filter: blur(0); scale: 1; pointer-events: auto;
    transition: opacity 200ms ease 120ms, filter 200ms ease 120ms, scale 300ms var(--out) 80ms;
  }
  :global(html:not(.js)) .island { width: auto; height: auto; padding: 8px; }
  :global(html:not(.js)) .island__inner { position: static; translate: 0 0; }

  /* Phones: the island grows downwards into a list, like a Live Activity. */
  @media (max-width: 640px) {
    .island { --open-r: 32px; }
    .island__inner { flex-direction: column; align-items: stretch; gap: 2px; padding: 8px; }
    .island__link { text-align: center; padding: 12px 24px; font-size: 17px; }
    .island__link:last-child { margin: 4px 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .island, .island.is-open { transition: none; }
    .island__inner { filter: none; scale: 1; transition: opacity 200ms ease; }
  }
</style>

<script>
  const island = document.querySelector<HTMLElement>('[data-island]');
  const hit = island?.querySelector<HTMLButtonElement>('.island__hit');
  const inner = island?.querySelector<HTMLElement>('.island__inner');
  if (island && hit && inner) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    // The open size is the content's own, measured, so width and height can animate to it.
    const measure = () => {
      island.style.setProperty('--open-w', `${Math.min(inner.offsetWidth + 16, innerWidth - 24)}px`);
      island.style.setProperty('--open-h', `${inner.offsetHeight + 16}px`);
    };
    const set = (open: boolean) => {
      if (open) measure();
      island.classList.toggle('is-open', open);
      hit.setAttribute('aria-expanded', String(open));
    };
    measure();
    addEventListener('resize', measure);
    // What is under the island: the nearest painted background just below it decides whether the
    // island is on a dark page, where it needs its ring and a step of grey to stay visible.
    const dark = () => {
      const r = island.getBoundingClientRect();
      const x = Math.min(innerWidth - 1, r.left + r.width / 2);
      const y = Math.min(innerHeight - 1, r.bottom + 6);
      for (const el of document.elementsFromPoint(x, y)) {
        if (island.contains(el)) continue;
        const m = getComputedStyle(el).backgroundColor.match(/\d+(\.\d+)?/g);
        if (!m || (m.length > 3 && Number(m[3]) === 0)) continue;
        const [cr, cg, cb] = m.map(Number);
        return (0.2126 * cr + 0.7152 * cg + 0.0722 * cb) < 80;
      }
      return false;
    };
    let ticking = false;
    let settle: number | undefined;
    const sense = () => {
      // Once per frame while scrolling, and once more when the scroll has settled (a smooth scroll
      // can end after its last scroll event has been sampled).
      clearTimeout(settle);
      settle = window.setTimeout(() => island.classList.toggle('is-on-dark', dark()), 120);
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { island.classList.toggle('is-on-dark', dark()); ticking = false; });
    };
    sense();
    addEventListener('scroll', sense, { passive: true });
    addEventListener('scrollend', sense);
    addEventListener('resize', sense);
    // Fine pointers: hover opens, leaving closes. Touch: tap toggles.
    island.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && fine.matches) set(true); });
    island.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && fine.matches) set(false); });
    hit.addEventListener('click', () => set(!island.classList.contains('is-open')));
    hit.addEventListener('focus', () => set(true));
    inner.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('pointerdown', (e) => { if (!island.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); hit.blur(); } });
  }
</script>
