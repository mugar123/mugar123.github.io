  font-size: 0.8125rem; line-height: 1.2; font-weight: 500; color: var(--ink-2);
  }
  .unis__count { font: 500 0.75rem/1.2 var(--mono); letter-spacing: 0.01em; font-variant-numeric: tabular-nums; }
  .tile--unis .marquee {
  display: grid; gap: 0.5rem;
  margin: 0; padding: 0;
  --fade: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.35) 1rem, rgba(0, 0, 0, 0.8) 2rem, #000 3rem, #000 calc(100% - 3rem), rgba(0, 0, 0, 0.8) calc(100% - 2rem), rgba(0, 0, 0, 0.35) calc(100% - 1rem), transparent);
  mask-image: var(--fade); -webkit-mask-image: var(--fade);
  }
  /* the second row is the same list started halfway through, so the two never show the same names together */
  .tile--unis .unis__row2 { animation-delay: -45s; }
  .tile--unis .logo-pill {
  height: 2.25rem; gap: 0.5rem;
  padding: 0 0.875rem 0 0.375rem;
  background: var(--bg);
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  font-size: 0.875rem; line-height: 1; letter-spacing: 0;
  color: var(--ink);
  }
  .tile--unis .logo-pill img {
  width: 1.5rem; height: 1.5rem; padding: 0;
  border-radius: 0; background: none; box-shadow: none;
  object-fit: contain;
  }
  @media (prefers-reduced-motion: reduce) {
