<script>
  // The reader demo: the segmented control swaps the rewrite level.
  document.querySelectorAll<HTMLElement>('[data-reader]').forEach((reader) => {
    const buttons = reader.querySelectorAll<HTMLButtonElement>('[data-level]');
    const texts = reader.querySelectorAll<HTMLElement>('[data-level-text]');
    const group = reader.querySelector<HTMLElement>('.segmented')!;
    let moving: number | undefined;
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      group.dataset.on = b.dataset.level;
      group.classList.add('is-moving');
      clearTimeout(moving);
      moving = window.setTimeout(() => group.classList.remove('is-moving'), 220);
      texts.forEach((t) => { t.hidden = t.dataset.levelText !== b.dataset.level; });
    }));
  });
</script>
