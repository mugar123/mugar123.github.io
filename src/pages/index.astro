---
import '@/styles/global.css';
import NotesScan from '@/components/NotesScan.astro';
import Island from '@/components/Island.astro';
import { helloStrokes, helloStrokeWidth, helloViewBox } from '@/data/hello';
import { sources, universities } from '@/data/papertok';

const title = 'Nicolás Muñoz García';
const description = 'Second-year physics student at the Universidad de Salamanca who ships software: PaperTok, a swipeable feed for arXiv papers, and a pipeline that turns handwritten notes into LaTeX.';
const email = 'nicomg60@gmail.com';

const statement = 'I study how the universe works. Between lectures, I build the tools I wish I had, and put them in front of real people.';

// What each part holds, under its name on the separation page.
const parts = {
  projects: 'PaperTok and a LaTeX converter',
  studies: 'BSc in Physics at the Universidad de Salamanca',
  how: 'Python, the web and LaTeX, with Claude Code, Codex and Cursor',
  contact: 'Open to internships and junior roles',
};
// Daily people on papertok.app (PostHog, 15 Oct to 2 Nov 2026), drawn as a sparkline behind the 748.
const daily = [55, 50, 21, 30, 28, 30, 430, 1061, 166, 87, 87, 98, 46, 49, 146, 122, 39, 38, 39];
// The chart's viewBox is 190×40 (uniform scale, so the dot stays round); 2 units of air above the peak.
const sparkPath = daily
  .map((v, i) => `${i === 0 ? 'M' : 'L'}${((i / (daily.length - 1)) * 190).toFixed(1)} ${(38.7 - (Math.log1p(v) / Math.log1p(1061)) * 36).toFixed(1)}`)
  .join(' ');
const sparkEnd = `190 ${(38.7 - (Math.log1p(daily[daily.length - 1]!) / Math.log1p(1061)) * 36).toFixed(1)}`;
// PaperTok figures, as of 3 November 2026: people from PostHog (last 30 days, internal accounts excluded),
// stars from GitHub, libraries and sources from the 0.3 release notes and the README.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>

    <Island />

    <main id="main">
      <section class="hero section--dark" id="top" aria-labelledby="hero-title">
        <canvas class="hero__waves" data-waves aria-hidden="true"></canvas>
        <div class="hero__copy container">
          <h1 class="hero__title" id="hero-title">
            <span class="sr-only">Hello, I’m Nicolás.</span>
            <svg class="hello" viewBox={helloViewBox} aria-hidden="true" data-hello>
              <g stroke-width={helloStrokeWidth}>{helloStrokes.map((s) => <path d={s.d} pathLength="1" data-delay={s.delay} data-duration={s.duration} />)}</g>
            </svg>
            <span class="hero__name" aria-hidden="true" data-after>I’m Nicolás.</span>
          </h1>
          <p class="hero__lede" data-after>Second-year physics student at the Universidad de Salamanca. <strong>When something in my studies is slower than it should be, I write the software that fixes it</strong>, and then I ship it.</p>
          <p class="hero__cta" data-after>
            <a class="pill" href="#projects">See the work</a>
            <a class="pill pill--glass" href="#contact">Get in touch</a>
          </p>
        </div>
      </section>

      <section class="statement section--dark" aria-label="In short" data-statement>
        <div class="statement__slide">
          <p class="statement__text container--wide" data-words>
            {statement.split(' ').map((word) => <><span class="w">{word}</span>{' '}</>)}
          </p>
        </div>
      </section>

      <section class="divider section--dark" id="projects" aria-labelledby="part-projects" data-divider>
        <div class="divider__pin">
          <h2 class="divider__title" id="part-projects">Projects.</h2>
          <p class="divider__sub">{parts.projects}</p>
        </div>
      </section>

      <section class="section section--alt" aria-labelledby="pt-title">
        <header class="intro container--wide">
          <p class="pt-brand"><img src="/papertok/logo.svg" alt="" width="40" height="40" />PaperTok</p>
          <h2 class="headline" id="pt-title">Scientific papers, in one feed.</h2>
          <p class="lede">For when you don’t know what to search for. <strong>Pick your fields and scroll</strong>, and the feed learns from what you read, like, save, skip and follow, while leaving room for the unexpected.</p>
          <p class="intro__cta">
            <a class="pill" href="https://papertok.app">Open PaperTok</a>
            <a class="more" href="https://github.com/mugar123/papertok">Source on GitHub</a>
          </p>
        </header>

        <div class="bento container--wide">
          <figure class="tile tile--full tile--shot">
            <figcaption class="sr-only">PaperTok 0.3: the feed and search</figcaption>
            <div class="devices">
              <div class="device"><div class="device__frame">
                <div class="device__screen">
                  <div class="device__status" aria-hidden="true"><span>9:41</span><i class="device__island"></i><span class="device__icons"><svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5" width="3" height="7" rx="1" /><rect x="10" y="2.5" width="3" height="9.5" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg><svg viewBox="0 0 26 12"><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".4" /><rect x="2" y="2" width="16" height="8" rx="2" /><rect x="23.5" y="4" width="1.8" height="4" rx="1" opacity=".4" /></svg></span></div>
                  <img src="/papertok/feed@4x.png" alt="The PaperTok feed: one paper per screen, with its field, title, authors and abstract, and a rail to like, save, explore connections and find similar papers" width="1560" height="3376" decoding="async" />
                </div>
              </div></div>
              <div class="device"><div class="device__frame">
                <div class="device__screen">
                  <div class="device__status" aria-hidden="true"><span>9:41</span><i class="device__island"></i><span class="device__icons"><svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5" width="3" height="7" rx="1" /><rect x="10" y="2.5" width="3" height="9.5" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg><svg viewBox="0 0 26 12"><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".4" /><rect x="2" y="2" width="16" height="8" rx="2" /><rect x="23.5" y="4" width="1.8" height="4" rx="1" opacity=".4" /></svg></span></div>
                  <img src="/papertok/search@4x.png" alt="PaperTok search, with suggestions for a topic, an institution, papers, an author and a project" width="1560" height="3376" decoding="async" />
                </div>
              </div></div>
            </div>
          </figure>

          <article class="tile tile--half tile--dark tile--people">
  <p class="tile__big">748<span> people</span></p>
  <p class="tile__text">used PaperTok in the last 30 days. It is free, open source and under active development.</p>
  <figure class="people-chart" role="img" aria-label="People per day from 15 October to 2 November on a log scale, peaking at 1,061 on 22 October." data-draw>
    <div class="people-chart__plot">
      <svg class="spark" viewBox="0 0 190 40" style={`--path: path('${sparkPath}')`}>
        <defs><linearGradient id="spark-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#30d158" stop-opacity="0.14" /><stop offset="1" stop-color="#30d158" stop-opacity="0" /></linearGradient></defs>
        <line class="spark__base" x1="0" y1="40" x2="190" y2="40" />
        <path class="spark__area" d={`${sparkPath} L190 40 L0 40 Z`} fill="url(#spark-fill)" />
        <path class="spark__line" d={sparkPath} pathLength="1" />
        <circle class="spark__peak" cx="73.9" cy="2.7" r="2" />
        <circle class="spark__halo" cx={sparkEnd.split(' ')[0]} cy={sparkEnd.split(' ')[1]} r="5.5" />
        <circle class="spark__dot" cx={sparkEnd.split(' ')[0]} cy={sparkEnd.split(' ')[1]} r="3" />
      </svg>
      <p class="people-chart__peak">1,061<span>22 Oct</span></p>
    </div>
    <p class="people-chart__axis"><span>15 Oct</span><span>2 Nov</span></p>
  </figure>
</article>
          <article class="tile tile--half tile--marquee tile--unis">
  <p class="tile__num">398</p>
  <p class="tile__text">university libraries it can open papers through. Verify a university email and PaperTok uses your library’s own access.</p>
  <div class="unis">
    <p class="unis__head"><span id="unis-label">Some of the universities</span><span class="unis__count">25 of 398</span></p>
    <div class="marquee" aria-labelledby="unis-label">
      <ul class="marquee__track">
        {[...universities, ...universities].map((u, i) => (
          <li class="logo-pill" aria-hidden={i >= universities.length ? 'true' : undefined}><img src={u.src} alt="" width="24" height="24" />{u.name}</li>
        ))}
      </ul>
      <ul class="marquee__track unis__row2" aria-hidden="true">
        {[...universities, ...universities].map((u) => (
          <li class="logo-pill"><img src={u.src} alt="" width="24" height="24" />{u.name}</li>
        ))}
      </ul>
    </div>
  </div>
</article>

          <article class="tile tile--stat">
  <svg class="stat__grid stat__grid--wide" viewBox="0 0 120 110" aria-hidden="true">
    <defs><pattern id="stars-wide" width="10" height="10" patternUnits="userSpaceOnUse"><path transform="translate(0.92 1.02) scale(0.34)" d="M12 3L14.6 9.03L21.13 9.63L16.2 13.96L17.64 20.37L12 17.02L6.36 20.37L7.8 13.96L2.87 9.63L9.4 9.03Z" /></pattern></defs>
    <rect width="120" height="100" fill="url(#stars-wide)" /><rect y="100" width="30" height="10" fill="url(#stars-wide)" />
  </svg>
  <svg class="stat__grid stat__grid--narrow" viewBox="0 0 80 160" aria-hidden="true">
    <defs><pattern id="stars-narrow" width="10" height="10" patternUnits="userSpaceOnUse"><path transform="translate(0.92 1.02) scale(0.34)" d="M12 3L14.6 9.03L21.13 9.63L16.2 13.96L17.64 20.37L12 17.02L6.36 20.37L7.8 13.96L2.87 9.63L9.4 9.03Z" /></pattern></defs>
    <rect width="80" height="150" fill="url(#stars-narrow)" /><rect y="150" width="30" height="10" fill="url(#stars-narrow)" />
  </svg>
  <div class="stat">
    <p class="stat__num">123</p>
    <p class="stat__label"><svg class="stat__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>GitHub stars</p>
  </div>
</article>
          <article class="tile tile--key">
  <h3 class="tile__title">All of science, one key.</h3>
  <p class="tile__text">Press <kbd>/</kbd> anywhere for papers, authors, topics, institutions and research projects.</p>
  <div class="palette" aria-hidden="true">
    <p class="palette__field"><svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.75"/><path d="m10.5 10.5 3.25 3.25"/></svg><span class="palette__q">Cosmol<i class="palette__caret"></i></span><kbd>/</kbd></p>
    <ul class="palette__list">
      <li class="is-on"><svg viewBox="0 0 16 16"><path d="M6 11.25v-.6c0-.75-.45-1.35-.95-1.9a4.25 4.25 0 1 1 5.9 0c-.5.55-.95 1.15-.95 1.9v.6Z"/><path d="M6.25 13.25h3.5M7 15h2"/></svg><span>Cosmology</span><em>Topic</em></li>
      <li class="palette__extra"><svg viewBox="0 0 16 16"><path d="M6 11.25v-.6c0-.75-.45-1.35-.95-1.9a4.25 4.25 0 1 1 5.9 0c-.5.55-.95 1.15-.95 1.9v.6Z"/><path d="M6.25 13.25h3.5M7 15h2"/></svg><span>Cosmological constant</span><em>Topic</em></li>
      <li><svg viewBox="0 0 16 16"><circle cx="8" cy="5.25" r="2.75"/><path d="M2.75 14.25c.55-2.75 2.7-4.5 5.25-4.5s4.7 1.75 5.25 4.5"/></svg><span>Planck Collaboration</span><em>Author</em></li>
    </ul>
  </div>
</article>
          <article class="tile tile--half tile--marquee">
            <h3 class="tile__title">One feed, one format.</h3>
            <p class="tile__text">Papers from every source are normalised before they are ranked. PaperTok links to them; it doesn’t host them.</p>
            <div class="marquee marquee--slow" aria-label="The sources PaperTok reads from">
              <ul class="marquee__track">
                {[...sources, ...sources].map((src, i) => (
                  <li class="logo-pill" aria-hidden={i >= sources.length ? 'true' : undefined}><img src={src.src} alt="" width="24" height="24" />{src.name}</li>
                ))}
              </ul>
              {[2, 3].map((row) => (
                <ul class={`marquee__track marquee__row${row}`} aria-hidden="true">
                  {[...sources, ...sources].map((src) => (
                    <li class="logo-pill"><img src={src.src} alt="" width="24" height="24" />{src.name}</li>
                  ))}
                </ul>
              ))}
            </div>
          </article>

          <article class="tile tile--half tile--read">
  <h3 class="tile__title">Any paper, at your level.</h3>
  <p class="tile__text">AI rewrites the full text for a beginner, a university student or a researcher. Highlight, take notes, ask about a passage, then export it all as LaTeX.</p>
  <div class="reader" data-reader>
    <div class="segmented" role="group" aria-label="Reading level" data-on="0">
      <span class="segmented__thumb" aria-hidden="true"></span><button type="button" class="is-on" aria-pressed="true" data-level="0">Beginner</button><button type="button" aria-pressed="false" data-level="1">University</button><button type="button" aria-pressed="false" data-level="2">Researcher</button>
    </div>
    <div class="reader__page">
      <div class="reader__body" aria-live="polite">
        <p class="reader__text" data-level-text="0">Black holes bend light so much that nothing nearby can escape. When two of them spiral together, they <mark>shake space itself</mark>, and we can now hear that shaking.</p>
        <p class="reader__text" data-level-text="1" hidden>Two black holes in a tight orbit lose energy as <mark>gravitational waves</mark>. The merger emits a chirp whose frequency rises until the horizons meet; LIGO measured the strain.</p>
        <p class="reader__text" data-level-text="2" hidden>The inspiral is modelled to 3.5PN order; the ringdown by quasinormal modes of the remnant Kerr black hole. Matched filtering against the template bank recovered <mark><i>h</i>&nbsp;≈&nbsp;10⁻²¹</mark>.</p>
      </div>
      <div class="reader__rail">
        <p class="reader__note"><span class="reader__tag">Your note</span>Gravitational waves, 2015.</p>
        <span class="reader__export" aria-hidden="true">Export .tex</span>
      </div>
    </div>
  </div>
</article>
          <article class="tile tile--map">
            <h3 class="tile__title">Follow the trail.</h3>
            <p class="tile__text">What a paper cites and what cites it, re-centred on any paper, with references as BibTeX.</p>
            <div class="cites" aria-hidden="true" data-trail>
              <svg class="cites__map" viewBox="0 0 240 192">
                <line class="cites__axis" x1="44" y1="96" x2="196" y2="96" />
                <path class="cites__ticks" d="M58 94v4M78 94v4M96 94v4M112 94v4M128 94v4M150 94v4M170 94v4M188 94v4" />
                <g class="cites__edges">
                  <path d="M120 96C120 58 58 58 58 20" /><path d="M120 96C120 58 96 58 96 20" /><path d="M120 96C120 58 112 58 112 20" />
                  <path d="M120 96C120 134 128 134 128 172" /><path d="M120 96C120 134 170 134 170 172" /><path d="M120 96C120 134 188 134 188 172" />
                  <path class="cites__came" d="M150 172C150 134 120 134 120 96" pathLength="1" />
                  <path class="cites__go" d="M120 96C120 58 78 58 78 20" pathLength="1" />
                </g>
                <g class="cites__nodes">
                  <circle cx="58" cy="20" r="5" /><circle cx="96" cy="20" r="3.5" /><circle cx="112" cy="20" r="5" />
                  <circle cx="128" cy="172" r="5" /><circle cx="170" cy="172" r="7" /><circle cx="188" cy="172" r="3.5" />
                </g>
                <circle class="cites__next" cx="78" cy="20" r="7" />
                <circle class="cites__seen" cx="150" cy="172" r="4.5" />
                <circle class="cites__ring" cx="120" cy="96" r="12.5" />
                <circle class="cites__me" cx="120" cy="96" r="8" />
              </svg>
              <span class="cites__label cites__label--up">cites</span>
              <span class="cites__label cites__label--from">2015</span>
              <span class="cites__label cites__label--to">2026</span>
              <span class="cites__label cites__label--down">cited by</span>
              <span class="cites__bib">BibTeX</span>
            </div>
          </article>
          <article class="tile tile--mail">
  <h3 class="tile__title">Every Monday.</h3>
  <p class="tile__text">New papers from the authors, topics and institutions you follow, by email.</p>
  <div class="mail" aria-hidden="true">
    <div class="mail__card">
      <div class="mail__head">
        <span class="mail__icon"><img src="/papertok/logo.svg" alt="" width="32" height="32" /></span>
        <p class="mail__from"><span>The PaperTok Weekly</span><time>Mon 9:41</time></p>
      </div>
      <p class="mail__subject">5 new papers from Planck Collaboration, Cosmology and 3 more</p>
      <p class="mail__preview">Hi there, welcome to your weekly selection of papers.</p>
    </div>
  </div>
</article>
        </div>
      </section>

      <NotesScan />

      <section class="divider section--dark" id="studies" aria-labelledby="part-studies" data-divider>
        <div class="divider__pin">
          <h2 class="divider__title" id="part-studies">Studies.</h2>
          <p class="divider__sub">{parts.studies}</p>
        </div>
      </section>

      <section class="section section--alt" aria-labelledby="studies-title">
        <header class="intro container--wide">
          <h2 class="headline" id="studies-title">Physics at Salamanca, class of 2029.</h2>
          <p class="lede">Bachillerato in science and technology, then a BSc in Physics at the Universidad de Salamanca. <strong>Now in second year.</strong></p>
        </header>
        <div class="tl container--wide" data-timeline="rail">
          <div class="tl__rail" aria-hidden="true"><div class="tl__fill"></div></div>
          <ol class="tl__list">
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2023">2023</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Bachillerato, science and technology.</h3>
                <p class="ms__meta">Upper secondary school, 2023–2025.</p>
              </div>
            </li>
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2024">2024</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Spanish Physics Olympiad.</h3>
                <p class="ms__meta">Olimpiada de Física, in the first year of Bachillerato.</p>
              </div>
            </li>
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2025">2025</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Spanish Physics Olympiad, again.</h3>
                <p class="ms__meta">In the second year of Bachillerato. Two consecutive editions.</p>
              </div>
            </li>
            <li class="ms ms--figures" data-ms>
              <p class="ms__when"><time datetime="2025-06">Jun 2025</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Bachillerato, finished.</h3>
                <dl class="ms__figures">
                  <div class="ms__figure">
                    <dt>University entrance exam (PAU)</dt>
                    <dd>12.501<span>/14</span></dd>
                  </div>
                  <div class="ms__figure">
                    <dt>Bachillerato average</dt>
                    <dd>9.06<span>/10</span></dd>
                  </div>
                </dl>
              </div>
            </li>
            <li class="ms ms--anchor" data-ms>
              <p class="ms__when"><time datetime="2025-09">Sep 2025</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <div class="ms__card">
                  <div>
                    <h3 class="ms__title">BSc in Physics.</h3>
                    <p class="ms__meta">Universidad de Salamanca, class of 2029. Member of Supernova, the university’s astronomy association.</p>
                  </div>
                  <img class="ms__logo" src="/studies/usal-color.svg" alt="Universidad de Salamanca" width="428" height="155" decoding="async" />
                </div>
              </div>
            </li>
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2026-09">Sep–Oct 2026</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title"><a href="https://bisite.usal.es/es/formacion/cursos/rna">Artificial neural networks: current models and the deep learning paradigm</a></h3>
                <p class="ms__meta">Course at BISITE, Universidad de Salamanca. 30 hours, 2 ECTS.</p>
              </div>
            </li>
            <li class="ms ms--now" data-ms>
              <p class="ms__when">Now</p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Second year of the degree.</h3>
                <p class="ms__meta">Academic year 2026–27.</p>
              </div>
            </li>
            <li class="ms ms--next" data-ms>
              <p class="ms__when">Next</p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
