---
/**
 * Music: the "Listening bar" (design 4 of the four that were tried). The records stand in a carousel
 * that turns sideways and comes round again; the one in the middle faces you. Tap it and it comes to
 * the front, still sealed, and its tear tape appears. Pull the
 * tab across the plastic to unwrap it; the disc slides out of the sleeve and the details follow. Put
 * it back and it goes back sealed, ready to be unwrapped again.
 * Behaviour lives in components/music/v4/listening-bar.ts.
 */
import StudioStory from '@/components/music/fl-studio/StudioStory.astro';
import LineupStory from '@/components/music/lineup/LineupStory.astro';
import MusicShell from '@/components/music/MusicShell.astro';
import { musicCopy } from '@/data/music';
import Headline from '@/components/music/v4/Headline.astro';
import Carousel from '@/components/music/v4/Carousel.astro';
import Caption from '@/components/music/v4/Caption.astro';
import OpenRecord from '@/components/music/v4/OpenRecord.astro';
import '@/components/music/v4/listening-bar.css';
---
<MusicShell title="Music" shareImage={{
  path: '/music/preview.jpg',
  width: 1200,
  height: 630,
  alt: '“I love music.” above a row of vinyl sleeves, with Kendrick Lamar’s good kid, m.A.A.d city in the middle.',
}}>
  <link slot="head" rel="license" href="/music/instruments/CREDITS.md" />
  <main id="main" class="v4" data-music-page data-intro>
    <div class="v4-page" data-v4-page>
      <section class="v4-intro v4-intro--wide" aria-labelledby="v4-title">
        <div class="container v4-intro__inner">
          <Headline />
        </div>
      </section>

      <!-- The shelf, and the climb: scrolling on past the records raises the camera until you look down
           on them lying in a ring, with how the collection came about in the middle (climb.ts). The stage stays on screen
           for that stretch of the scroll. -->
      <section class="v4-shelf" aria-labelledby="v4-shelf-title" data-intro-rest data-climb>
        <i class="v4-climb__probe" aria-hidden="true" data-climb-probe></i>
        <div class="v4-climb__stage" data-climb-stage>
          <div class="v4-floor" aria-hidden="true" data-climb-floor></div>
          <div class="v4-bar">
            <div class="v4-bar__wall" aria-hidden="true" data-climb-wall></div>
            <!-- The heading hangs on the wall above the records, on the page's left edge. -->
            <header class="container v4-shelf__head" data-climb-head>
              <h2 class="v4-shelf__title" id="v4-shelf-title">{musicCopy.shelf.headline}</h2>
              <p class="lede v4-shelf__lede">{musicCopy.shelf.lede}</p>
            </header>
            <Carousel />
          </div>

          <Caption />

          <div class="v4-making" data-climb-words>
            {musicCopy.collection.map((passage) => (
              <p class="v4-making__page" data-climb-page>
                {passage.split(' ').map((word) => <><span class="w" data-w>{word}</span>{' '}</>)}
              </p>
            ))}
          </div>
        </div>
      </section>
      <LineupStory />
      <!-- The way out once the last chapter is over: back to the home page. -->
      <StudioStory>
        <nav aria-label="Leave the music page">
          <a class="pill pill--glass" href="/">Back to the home page</a>
        </nav>
      </StudioStory>
    </div>

    <OpenRecord />
  </main>
</MusicShell>

<script>
  import '@/components/music/v4/listening-bar';
  import '@/components/music/v4/climb';
  import '@/components/music/v4/intro';
</script>
